// Возвращает JSON Schema аргументов инструмента get_calendar_agenda.
//
// Поля:
//   from_minute - Необязательное целое >= 0. Левая граница диапазона
//                 игрового времени. Если не задана - используется
//                 текущее игровое время активной кампании.
//   to_minute   - Необязательное целое >= 0. Правая граница диапазона
//                 (включительно). Если задана вместе с from_minute,
//                 должна быть >= from_minute. Если не задана -
//                 возвращаются ближайшие события начиная с from_minute.
//   limit       - Необязательное целое 1..50. По умолчанию 20.
//
// Никакие дополнительные свойства не принимаются.
//
// Возвращаемое значение:
//   Структура - эквивалент JSON Schema.
//
Функция СхемаАргументов_GetCalendarAgenda()

	FromMinute = Новый Структура;
	FromMinute.Вставить("type", "integer");
	FromMinute.Вставить("minimum", 0);

	ToMinute = Новый Структура;
	ToMinute.Вставить("type", "integer");
	ToMinute.Вставить("minimum", 0);

	Limit = Новый Структура;
	Limit.Вставить("type", "integer");
	Limit.Вставить("minimum", 1);
	Limit.Вставить("maximum", 50);
	Limit.Вставить("default", 20);

	Properties = Новый Структура;
	Properties.Вставить("from_minute", FromMinute);
	Properties.Вставить("to_minute",   ToMinute);
	Properties.Вставить("limit",       Limit);

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Properties);
	Схема.Вставить("additionalProperties", Ложь);

	Возврат Схема;

КонецФункции

// Реализация инструмента get_current_context:
//  1) проверяет допустимость аргументов (Неопределено или пустая Структура);
//  2) проверяет наличие активной кампании;
//  3) получает снимок контекста через КонтекстАссистента;
//  4) преобразует результат в AI-facing DTO.
//
// Параметры:
//   Аргументы - Структура, Неопределено - аргументы инструмента.
//
// Возвращаемое значение:
//   Структура - унифицированный результат.
//
Функция Выполнить_GetCurrentContext(Аргументы)

	Если НЕ ПроверитьАргументы_GetCurrentContext(Аргументы) Тогда
		Возврат РезультатОшибка("invalid_arguments",
			НСтр("ru = 'Инструмент get_current_context не принимает аргументов.'"));
	КонецЕсли;

	Кампания = УправлениеКампаниями.ПолучитьАктивнуюКампанию();
	Если НЕ ЗначениеЗаполнено(Кампания) Тогда
		Возврат РезультатОшибка("no_active_campaign",
			НСтр("ru = 'Не задана активная кампания.'"));
	КонецЕсли;

	Снимок = КонтекстАссистента.ПолучитьКонтекст();
	DTO = СнимокКонтекстаВDTO(Снимок);

	Возврат РезультатУспех(DTO);

КонецФункции

// Проверяет, что аргументы соответствуют схеме инструмента
// get_current_context: Неопределено или пустая Структура.
// Любое свойство в переданной структуре трактуется как
// недопустимый аргумент.
//
// Параметры:
//   Аргументы - Структура, Неопределено - аргументы инструмента.
//
// Возвращаемое значение:
//   Булево - Истина, если аргументы корректны.
//
Функция ПроверитьАргументы_GetCurrentContext(Аргументы)

	Если Аргументы = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТипЗнч(Аргументы) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Аргументы.Количество() = 0;

КонецФункции

// Реализация инструмента search_entities:
//  1) проверяет допустимость аргументов (query обязателен, types и limit -
//     по схеме);
//  2) проверяет наличие активной кампании;
//  3) запрашивает расширенный поиск у ПоискСущностей по нормализованной
//     строке;
//  4) применяет limit и признак truncated;
//  5) преобразует кандидатов в AI-facing DTO.
//
// Инструмент всегда работает только в пределах активной кампании,
// никаких аргументов выбора кампании не принимает.
//
// Параметры:
//   Аргументы - Структура, Неопределено - аргументы инструмента.
//
// Возвращаемое значение:
//   Структура - унифицированный результат.
//
Функция Выполнить_SearchEntities(Аргументы)

	ПараметрыВызова = ПроверитьАргументы_SearchEntities(Аргументы);
	Если ТипЗнч(ПараметрыВызова) <> Тип("Структура") Тогда
		Возврат РезультатОшибка("invalid_arguments",
			НСтр("ru = 'Некорректные аргументы search_entities.'"));
	КонецЕсли;

	Кампания = УправлениеКампаниями.ПолучитьАктивнуюКампанию();
	Если НЕ ЗначениеЗаполнено(Кампания) Тогда
		Возврат РезультатОшибка("no_active_campaign",
			НСтр("ru = 'Не задана активная кампания.'"));
	КонецЕсли;

	НормализованнаяСтрока = ПоискСущностей.НормализоватьСтроку(ПараметрыВызова.Query);

	КандидатыТаблица = ПоискСущностей.НайтиСущностиРасширенный(
		ПараметрыВызова.Query, ПараметрыВызова.Types);

	DTO = КандидатыПоискаВDTO(ПараметрыВызова.Query, НормализованнаяСтрока,
		КандидатыТаблица, ПараметрыВызова.Limit);

	Возврат РезультатУспех(DTO);

КонецФункции

// Проверяет аргументы search_entities и приводит их к каноническому виду.
// Возвращает структуру полей (Query, Types, Limit) при успехе или
// Неопределено при ошибке.
//
// Правила:
//   - query: Строка, после СокрЛП длина 1..150, не Неопределено;
//   - types: Необязательный. Если отсутствует - Неопределено (поиск по
//     всем типам). Иначе - Массив из Строка, длиной >= 1, без дублей,
//     только допустимые stable codes;
//   - limit: Необязательный. Если отсутствует - 10. Иначе - целое Число
//     в диапазоне 1..20. Не допускается автоматическое приведение
//     "10" -> 10 или 1.5 -> 2.
//   - Любое дополнительное свойство - ошибка.
//
Функция ПроверитьАргументы_SearchEntities(Аргументы)

	Если ТипЗнч(Аргументы) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ ТолькоДопустимыеКлючиSearchEntities(Аргументы) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Query = ПроверитьИИзвлечьQuery_SearchEntities(Аргументы);
	Если Query = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Types = ПроверитьИИзвлечьTypes_SearchEntities(Аргументы);
	Если Аргументы.Свойство("types") И Types = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Limit = ПроверитьИИзвлечьLimit_SearchEntities(Аргументы);
	Если Аргументы.Свойство("limit") И Limit = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Query", Query);
	Результат.Вставить("Types", Types);
	Результат.Вставить("Limit", Limit);

	Возврат Результат;

КонецФункции

// Проверяет, что в аргументах search_entities нет посторонних ключей.
//
Функция ТолькоДопустимыеКлючиSearchEntities(Аргументы)

	ДопустимыеКлючи = Новый Соответствие;
	ДопустимыеКлючи.Вставить("query", Истина);
	ДопустимыеКлючи.Вставить("types", Истина);
	ДопустимыеКлючи.Вставить("limit", Истина);

	Для Каждого КлючИЗначение Из Аргументы Цикл
		Если ДопустимыеКлючи.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Извлекает и валидирует query. Возвращает строку после СокрЛП
// или Неопределено при ошибке.
//
Функция ПроверитьИИзвлечьQuery_SearchEntities(Аргументы)

	Если НЕ Аргументы.Свойство("query") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = Аргументы.query;
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Query = СокрЛП(Значение);
	Если ПустаяСтрока(Query) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если СтрДлина(Query) > МаксимальнаяДлинаЗапроса() Тогда
		Возврат Неопределено;
	КонецЕсли;

	НормализованнаяСтрока = ПоискСущностей.НормализоватьСтроку(Query);
	Если ПустаяСтрока(НормализованнаяСтрока) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Query;

КонецФункции

// Извлекает и валидирует types. Возвращает массив строк
// (без дублей, только допустимые коды), либо Неопределено, если
// свойство types отсутствует. Если свойство задано, но невалидно -
// возвращает Неопределено.
//
Функция ПроверитьИИзвлечьTypes_SearchEntities(Аргументы)

	Если НЕ Аргументы.Свойство("types") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = Аргументы.types;
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Значение.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДопустимыеКоды = Новый Соответствие;
	Для Каждого ОписаниеТипа Из ПоискСущностей.ПоддерживаемыеТипы() Цикл
		ДопустимыеКоды.Вставить(ОписаниеТипа.StableCode, Истина);
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого Элемент Из Значение Цикл
		Если ТипЗнч(Элемент) <> Тип("Строка") Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если ДопустимыеКоды.Получить(Элемент) = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если Результат.Найти(Элемент) <> Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Извлекает и валидирует limit. Возвращает целое число 1..20
// (по умолчанию ЛимитПоУмолчанию()) либо Неопределено, если
// свойство limit задано некорректно. Если свойство отсутствует -
// возвращает значение по умолчанию.
//
Функция ПроверитьИИзвлечьLimit_SearchEntities(Аргументы)

	Если НЕ Аргументы.Свойство("limit") Тогда
		Возврат ЛимитПоУмолчанию();
	КонецЕсли;

	Значение = Аргументы.limit;
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Запрет автоматических преобразований 1.5 -> 2.
	Если Значение <> Цел(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Значение < 1 ИЛИ Значение > МаксимальныйЛимит() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Максимально допустимая длина строки запроса search_entities.
//
Функция МаксимальнаяДлинаЗапроса()

	Возврат 150;

КонецФункции

// Лимит search_entities по умолчанию.
//
Функция ЛимитПоУмолчанию()

	Возврат 10;

КонецФункции

// Верхняя граница лимита search_entities.
//
Функция МаксимальныйЛимит()

	Возврат 20;

КонецФункции

// Преобразует таблицу кандидатов ПоискСущностей.НайтиСущностиРасширенный
// в AI DTO search_entities. Применяет лимит и вычисляет truncated.
//
// Лимит накладывается на уже глобально отсортированный результат,
// поэтому внутренняя выборка ПоискСущностей не зависит от лимита.
//
// Параметры:
//   Query              - Строка - исходный (после СокрЛП) запрос.
//   НормализованнаяСтрока - Строка - результат
//                          ПоискСущностей.НормализоватьСтроку(Query).
//   КандидатыТаблица   - ТаблицаЗначений - результат
//                          ПоискСущностей.НайтиСущностиРасширенный().
//   Limit              - Число - 1..20.
//
// Возвращаемое значение:
//   Структура - DTO:
//     * query            - Строка, Неопределено
//     * normalized_query - Строка
//     * items            - Массив Из Структура
//     * truncated        - Булево
//
Функция КандидатыПоискаВDTO(Query, НормализованнаяСтрока, КандидатыТаблица, Limit)

	Items = Новый Массив;

	ОбщееЧисло = КандидатыТаблица.Количество();
	ВозвращаемоеЧисло = Мин(ОбщееЧисло, Limit);
	Truncated = ОбщееЧисло > ВозвращаемоеЧисло;

	Для Сч = 0 По ВозвращаемоеЧисло - 1 Цикл
		СтрокаКандидата = КандидатыТаблица.Получить(Сч);
		Items.Добавить(КандидатВDTO(СтрокаКандидата));
	КонецЦикла;

	DTO = Новый Структура;
	DTO.Вставить("query", Query);
	DTO.Вставить("normalized_query", НормализованнаяСтрока);
	DTO.Вставить("items", Items);
	DTO.Вставить("truncated", Truncated);

	Возврат DTO;

КонецФункции

// Преобразует строку кандидата из таблицы
// ПоискСущностей.НайтиСущностиРасширенный в AI DTO.
//
// Параметры:
//   СтрокаКандидата - СтрокаТаблицыЗначений.
//
// Возвращаемое значение:
//   Структура - {id, type, name, match}.
//
Функция КандидатВDTO(СтрокаКандидата)

	DTO = Новый Структура;
	DTO.Вставить("id", СтрокаКандидата.Идентификатор);
	DTO.Вставить("type", СтрокаКандидата.StableCode);
	DTO.Вставить("name", СтрокаКандидата.Наименование);
	DTO.Вставить("match", СтрокаКандидата.ЛучшееСовпадение);

	Возврат DTO;

КонецФункции

// Реализация инструмента get_entity:
//  1) проверяет допустимость аргументов (id и type обязательны);
//  2) проверяет наличие активной кампании;
//  3) разбирает UUID и получает ссылку через ПоискСущностей
//     с проверкой принадлежности активной кампании;
//  4) формирует компактный AI-facing DTO.
//
// Инструмент read-only и всегда работает только в пределах активной
// кампании. Никаких аргументов выбора кампании не принимает.
//
// Параметры:
//   Аргументы - Структура, Неопределено - аргументы инструмента.
//
// Возвращаемое значение:
//   Структура - унифицированный результат.
//
Функция Выполнить_GetEntity(Аргументы)

	ПараметрыВызова = ПроверитьАргументы_GetEntity(Аргументы);
	Если ТипЗнч(ПараметрыВызова) <> Тип("Структура") Тогда
		Возврат РезультатОшибка("invalid_arguments",
			НСтр("ru = 'Некорректные аргументы get_entity.'"));
	КонецЕсли;

	Кампания = УправлениеКампаниями.ПолучитьАктивнуюКампанию();
	Если НЕ ЗначениеЗаполнено(Кампания) Тогда
		Возврат РезультатОшибка("no_active_campaign",
			НСтр("ru = 'Не задана активная кампания.'"));
	КонецЕсли;

	РезультатПоиска = ПоискСущностей.ПолучитьСущностьПоИдентификатору(
		ПараметрыВызова.StableCode,
		ПараметрыВызова.УИД,
		Кампания);

	Если НЕ РезультатПоиска.Найдено Тогда
		Возврат РезультатОшибка("entity_not_found",
			НСтр("ru = 'Сущность не найдена в активной кампании.'"));
	КонецЕсли;

	DTO = СущностьВDTO(РезультатПоиска.Объект, ПараметрыВызова.StableCode,
		РезультатПоиска.Наименование);

	Возврат РезультатУспех(DTO);

КонецФункции

// Проверяет аргументы get_entity и приводит их к каноническому виду.
// Возвращает структуру полей (УИД, StableCode) при успехе или
// Неопределено при ошибке.
//
// Правила:
//   - id: обязателен, непустая Строка, успешно разбирается
//     в УникальныйИдентификатор. Регистр символов не имеет значения.
//   - type: обязателен, Строка, присутствует в
//     ПоискСущностей.ПоддерживаемыеТипы().
//   - Любое дополнительное свойство - ошибка.
//
Функция ПроверитьАргументы_GetEntity(Аргументы)

	Если ТипЗнч(Аргументы) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ ТолькоДопустимыеКлючиGetEntity(Аргументы) Тогда
		Возврат Неопределено;
	КонецЕсли;

	УИД = ПроверитьИИзвлечьId_GetEntity(Аргументы);
	Если УИД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	StableCode = ПроверитьИИзвлечьType_GetEntity(Аргументы);
	Если StableCode = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("УИД", УИД);
	Результат.Вставить("StableCode", StableCode);

	Возврат Результат;

КонецФункции

// Проверяет, что в аргументах get_entity нет посторонних ключей.
//
Функция ТолькоДопустимыеКлючиGetEntity(Аргументы)

	ДопустимыеКлючи = Новый Соответствие;
	ДопустимыеКлючи.Вставить("id", Истина);
	ДопустимыеКлючи.Вставить("type", Истина);

	Для Каждого КлючИЗначение Из Аргументы Цикл
		Если ДопустимыеКлючи.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Извлекает и валидирует id. Принимает только непустую строку,
// успешно разбираемую в УникальныйИдентификатор. Регистр символов
// не имеет значения.
//
// Возвращает УникальныйИдентификатор либо Неопределено.
//
Функция ПроверитьИИзвлечьId_GetEntity(Аргументы)

	Если НЕ Аргументы.Свойство("id") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = Аргументы.id;
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	НормализованныйИдентификатор = СокрЛП(Значение);
	Если ПустаяСтрока(НормализованныйИдентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если СтрДлина(НормализованныйИдентификатор) > МаксимальнаяДлинаИдентификатора() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		УИД = Новый УникальныйИдентификатор(НормализованныйИдентификатор);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат УИД;

КонецФункции

// Извлекает и валидирует type. Принимает только Строку, присутствующую
// в ПоискСущностей.ПоддерживаемыеТипы().
//
// Возвращает стабильный код типа либо Неопределено.
//
Функция ПроверитьИИзвлечьType_GetEntity(Аргументы)

	Если НЕ Аргументы.Свойство("type") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = Аргументы.type;
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДопустимыеКоды = Новый Соответствие;
	Для Каждого ОписаниеТипа Из ПоискСущностей.ПоддерживаемыеТипы() Цикл
		ДопустимыеКоды.Вставить(ОписаниеТипа.StableCode, Истина);
	КонецЦикла;

	Если ДопустимыеКоды.Получить(Значение) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Верхняя граница длины строкового идентификатора,
// принимаемого инструментом get_entity.
//
Функция МаксимальнаяДлинаИдентификатора()

	Возврат 40;

КонецФункции

// Реализация инструмента get_relations:
//  1) проверяет допустимость аргументов (id и type обязательны,
//     direction и limit - по схеме);
//  2) проверяет наличие активной кампании;
//  3) точечно разрешает исходную сущность через R03 API с проверкой
//     принадлежности активной кампании;
//  4) читает прямые связи через предметный слой СвязиСущностей;
//  5) применяет фильтр направления и пакетно получает name/type
//     связанных сущностей, не обращаясь к get_entity рекурсивно;
//  6) обеспечивает campaign isolation обеих сторон связи
//     (исходная сущность уже проверена, связанные - верифицируются);
//  7) дедуплицирует, сортирует детерминированно, применяет limit
//     и формирует AI-facing DTO.
//
// Инструмент read-only: не добавляет, не удаляет и не изменяет связи.
// Рекурсивный обход графа не выполняется.
//
// Параметры:
//   Аргументы - Структура, Неопределено - аргументы инструмента.
//
// Возвращаемое значение:
//   Структура - унифицированный результат.
//
Функция Выполнить_GetRelations(Аргументы)

	// Сценарий R04/I: полностью отсутствующий или пустой id трактуется
	// как entity_not_found (а не invalid_arguments), чтобы AI получал
	// согласованный ответ "сущность не найдена" при попытках вызвать
	// инструмент без валидного идентификатора.
	//
	// Сценарий R04/H: id передан, но имеет неверный тип (не Строка) либо
	// синтаксически не является UUID - трактуется как invalid_arguments.
	// Это отделяет "не передан идентификатор" от "передан, но невалидный".
	Если ТипЗнч(Аргументы) <> Тип("Структура")
		ИЛИ НЕ Аргументы.Свойство("id") Тогда
		Возврат РезультатОшибка("entity_not_found",
			НСтр("ru = 'Сущность не найдена в активной кампании.'"));
	КонецЕсли;

	ЗначениеId = Аргументы.id;
	Если ЗначениеId = Неопределено ИЛИ ПустаяСтрока(СокрЛП(Строка(ЗначениеId))) Тогда
		Возврат РезультатОшибка("entity_not_found",
			НСтр("ru = 'Сущность не найдена в активной кампании.'"));
	КонецЕсли;

	Если ТипЗнч(ЗначениеId) <> Тип("Строка") Тогда
		Возврат РезультатОшибка("invalid_arguments",
			НСтр("ru = 'Некорректные аргументы get_relations: id должен быть строкой.'"));
	КонецЕсли;

	Попытка
		// Присваивание обязательно - Xtext BSL-парсер EDT не принимает
		// автономное выражение-результат "Новый ...". Само значение УИД
		// здесь не используется, проверяется только факт успешного
		// разбора строки в УникальныйИдентификатор.
		//@skip-check UnusedLocalVariable
		УИДДляПроверки = Новый УникальныйИдентификатор(СокрЛП(ЗначениеId));
	Исключение
		Возврат РезультатОшибка("invalid_arguments",
			НСтр("ru = 'Некорректные аргументы get_relations: id не является UUID.'"));
	КонецПопытки;

	ПараметрыВызова = ПроверитьАргументы_GetRelations(Аргументы);
	Если ТипЗнч(ПараметрыВызова) <> Тип("Структура") Тогда
		Возврат РезультатОшибка("invalid_arguments",
			НСтр("ru = 'Некорректные аргументы get_relations.'"));
	КонецЕсли;

	Кампания = УправлениеКампаниями.ПолучитьАктивнуюКампанию();
	Если НЕ ЗначениеЗаполнено(Кампания) Тогда
		Возврат РезультатОшибка("no_active_campaign",
			НСтр("ru = 'Не задана активная кампания.'"));
	КонецЕсли;

	РезультатПоиска = ПоискСущностей.ПолучитьСущностьПоИдентификатору(
		ПараметрыВызова.StableCode,
		ПараметрыВызова.УИД,
		Кампания);

	Если НЕ РезультатПоиска.Найдено Тогда
		Возврат РезультатОшибка("entity_not_found",
			НСтр("ru = 'Сущность не найдена в активной кампании.'"));
	КонецЕсли;

	ОписанияСвязей = СвязиСущностей.ПолучитьСвязи(РезультатПоиска.Объект);

	ОписанияЭлементов = ЭлементыСвязейДляDTO(
		РезультатПоиска.Объект,
		ОписанияСвязей,
		Кампания,
		ПараметрыВызова.Direction);

	ОписанияЭлементов.Сортировать("ПорядокНаправления, КодТипаСвязи, СортируемоеИмя, StableCode, Идентификатор");

	DTO = СвязиВDTO(РезультатПоиска.Объект, ПараметрыВызова.StableCode,
		РезультатПоиска.Наименование, ОписанияЭлементов, ПараметрыВызова.Limit);

	Возврат РезультатУспех(DTO);

КонецФункции

// Проверяет аргументы get_relations и приводит их к каноническому виду.
// Возвращает структуру полей (УИД, StableCode, Direction, Limit) при
// успехе или Неопределено при ошибке.
//
// Правила:
//   - id: обязателен, непустая Строка, успешно разбирается
//     в УникальныйИдентификатор. Регистр символов не имеет значения.
//   - type: обязателен, Строка, присутствует в
//     ПоискСущностей.ПоддерживаемыеТипы().
//   - direction: необязательный, по умолчанию "both". Допустимы
//     "both", "outgoing", "incoming".
//   - limit: необязательный, по умолчанию 20. Целое Число в 1..50.
//     Не допускается автоматическое приведение "20" -> 20 или 1.5 -> 2.
//   - Любое дополнительное свойство - ошибка.
//
Функция ПроверитьАргументы_GetRelations(Аргументы)

	Если ТипЗнч(Аргументы) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ ТолькоДопустимыеКлючиGetRelations(Аргументы) Тогда
		Возврат Неопределено;
	КонецЕсли;

	УИД = ПроверитьИИзвлечьId_GetRelations(Аргументы);
	Если УИД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	StableCode = ПроверитьИИзвлечьType_GetRelations(Аргументы);
	Если StableCode = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Direction = ПроверитьИИзвлечьDirection_GetRelations(Аргументы);
	Если Аргументы.Свойство("direction") И Direction = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Limit = ПроверитьИИзвлечьLimit_GetRelations(Аргументы);
	Если Аргументы.Свойство("limit") И Limit = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("УИД", УИД);
	Результат.Вставить("StableCode", StableCode);
	Результат.Вставить("Direction", Direction);
	Результат.Вставить("Limit", Limit);

	Возврат Результат;

КонецФункции

// Проверяет, что в аргументах get_relations нет посторонних ключей.
//
Функция ТолькоДопустимыеКлючиGetRelations(Аргументы)

	ДопустимыеКлючи = Новый Соответствие;
	ДопустимыеКлючи.Вставить("id", Истина);
	ДопустимыеКлючи.Вставить("type", Истина);
	ДопустимыеКлючи.Вставить("direction", Истина);
	ДопустимыеКлючи.Вставить("limit", Истина);

	Для Каждого КлючИЗначение Из Аргументы Цикл
		Если ДопустимыеКлючи.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Извлекает и валидирует id. Принимает только непустую строку,
// успешно разбираемую в УникальныйИдентификатор. Регистр символов
// не имеет значения.
//
// Возвращает УникальныйИдентификатор либо Неопределено.
//
Функция ПроверитьИИзвлечьId_GetRelations(Аргументы)

	Если НЕ Аргументы.Свойство("id") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = Аргументы.id;
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	НормализованныйИдентификатор = СокрЛП(Значение);
	Если ПустаяСтрока(НормализованныйИдентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если СтрДлина(НормализованныйИдентификатор) > МаксимальнаяДлинаИдентификатора() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		УИД = Новый УникальныйИдентификатор(НормализованныйИдентификатор);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат УИД;

КонецФункции

// Извлекает и валидирует type. Принимает только Строку, присутствующую
// в ПоискСущностей.ПоддерживаемыеТипы().
//
// Возвращает стабильный код типа либо Неопределено.
//
Функция ПроверитьИИзвлечьType_GetRelations(Аргументы)

	Если НЕ Аргументы.Свойство("type") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = Аргументы.type;
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДопустимыеКоды = Новый Соответствие;
	Для Каждого ОписаниеТипа Из ПоискСущностей.ПоддерживаемыеТипы() Цикл
		ДопустимыеКоды.Вставить(ОписаниеТипа.StableCode, Истина);
	КонецЦикла;

	Если ДопустимыеКоды.Получить(Значение) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Извлекает и валидирует direction. Если свойство отсутствует -
// возвращает "both". Если задано недопустимое значение - Неопределено.
//
Функция ПроверитьИИзвлечьDirection_GetRelations(Аргументы)

	Если НЕ Аргументы.Свойство("direction") Тогда
		Возврат "both";
	КонецЕсли;

	Значение = Аргументы.direction;
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Значение = "both" ИЛИ Значение = "outgoing" ИЛИ Значение = "incoming" Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Извлекает и валидирует limit. Возвращает целое число 1..50
// (по умолчанию ЛимитПоУмолчанию_GetRelations()) либо Неопределено,
// если свойство limit задано некорректно.
//
Функция ПроверитьИИзвлечьLimit_GetRelations(Аргументы)

	Если НЕ Аргументы.Свойство("limit") Тогда
		Возврат ЛимитПоУмолчанию_GetRelations();
	КонецЕсли;

	Значение = Аргументы.limit;
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Запрет автоматических преобразований 1.5 -> 2.
	Если Значение <> Цел(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Значение < 1 ИЛИ Значение > МаксимальныйЛимит_GetRelations() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Лимит get_relations по умолчанию.
//
Функция ЛимитПоУмолчанию_GetRelations()

	Возврат 20;

КонецФункции

// Верхняя граница лимита get_relations.
//
Функция МаксимальныйЛимит_GetRelations()

	Возврат 50;

КонецФункции

// Формирует таблицу элементов связей в каноническом виде,
// пригодном для детерминированной сортировки и последующего
// преобразования в DTO.
//
// Выполняет:
//   - фильтрацию по направлению (outgoing/incoming/both);
//   - определение семантического направления
//     (outgoing/incoming/symmetric) на основании предметного
//     признака Симметричная и стороны хранения записи;
//   - дедупликацию (одна физическая запись - один элемент);
//   - проверку принадлежности связанной сущности активной
//     кампании (campaign isolation обеих сторон);
//   - отбрасывание помеченных на удаление связанных сущностей;
//   - пакетное получение name/type для связанных объектов
//     (без обращения к AI-инструменту get_entity).
//
// Параметры:
//   ИсходныйОбъект - ОпределяемыйТип.СущностиКампании - исходная
//                    сущность, для которой запрашивались связи.
//   ОписанияСвязей  - Массив - результат СвязиСущностей.ПолучитьСвязи().
//   Кампания        - СправочникСсылка.Кампании - активная кампания.
//   Direction       - Строка - "both" / "outgoing" / "incoming".
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * НаправлениеDTO     - Строка - "outgoing"/"incoming"/"symmetric"
//     * ПорядокНаправления - Число - 1/2/3 для детерминированной сортировки
//     * КодТипаСвязи       - Строка - стабильный код типа связи
//     * ИмяТипаСвязи       - Строка - человекочитаемая подпись
//     * СвязанныйОбъект    - ОпределяемыйТип.СущностиКампании
//     * StableCode         - Строка - стабильный код типа связанной сущности
//     * ИмяСвязанногоОбъекта - Строка - каноническое имя
//     * Идентификатор      - Строка - UUID связанной сущности
//     * СортируемоеИмя     - Строка - нормализованное имя для сортировки
//     * Комментарий        - Строка
//
Функция ЭлементыСвязейДляDTO(ИсходныйОбъект, ОписанияСвязей, Кампания, Direction)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("НаправлениеDTO",     Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	Таблица.Колонки.Добавить("ПорядокНаправления", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("КодТипаСвязи",       Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(40)));
	Таблица.Колонки.Добавить("ИмяТипаСвязи",       Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	Таблица.Колонки.Добавить("СвязанныйОбъект");
	Таблица.Колонки.Добавить("StableCode",         Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(40)));
	Таблица.Колонки.Добавить("ИмяСвязанногоОбъекта", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	Таблица.Колонки.Добавить("Идентификатор",      Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(40)));
	Таблица.Колонки.Добавить("СортируемоеИмя",     Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	Таблица.Колонки.Добавить("Комментарий",        Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));

	Если ОписанияСвязей.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;

	// Группируем связанные ссылки для пакетного разрешения name/type.
	СоответствиеСвязанных = Новый Соответствие;
	Для Каждого Описание Из ОписанияСвязей Цикл
		Если НЕ ЗначениеЗаполнено(Описание.СвязанныйОбъект) Тогда
			Продолжить;
		КонецЕсли;
		Если СоответствиеСвязанных.Получить(Описание.СвязанныйОбъект) = Неопределено Тогда
			СоответствиеСвязанных.Вставить(Описание.СвязанныйОбъект, Истина);
		КонецЕсли;
	КонецЦикла;

	ИменаСвязанных = МассивИзКлючейСоответствия(СоответствиеСвязанных);
	ДанныеСвязанных = ПакетныеДанныеСвязанныхСущностей(ИменаСвязанных, Кампания);

	// Ключ дедупликации: для симметричной связи - по паре объектов
	// (без учёта порядка), для направленной - по (типСвязи, Объект, Связанный).
	ВиденныеКлючи = Новый Соответствие;

	// Кеш стабильных кодов типов связей - чтобы не повторять
	// обращение к предметному слою для одной и той же ссылки.
	КешКодовТипов = Новый Соответствие;

	Для Каждого Описание Из ОписанияСвязей Цикл

		Связанный = Описание.СвязанныйОбъект;
		Если НЕ ЗначениеЗаполнено(Связанный) Тогда
			Продолжить;
		КонецЕсли;

		// Campaign isolation обеих сторон: связанная сущность
		// должна существовать, принадлежать активной кампании
		// и не быть помеченной на удаление.
		ДанныеСвязанного = ДанныеСвязанных.Получить(Связанный);
		Если ДанныеСвязанного = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Определяем семантическое направление.
		НаправлениеDTO = ОпределитьНаправлениеDTO(Описание);
		Если НаправлениеDTO = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Фильтр по направлению.
		Если Direction = "outgoing" И НаправлениеDTO = "incoming" Тогда
			Продолжить;
		ИначеЕсли Direction = "incoming" И НаправлениеDTO = "outgoing" Тогда
			Продолжить;
		КонецЕсли;

		// Дедупликация. Для симметричной связи канонический ключ пары
		// (исходный, связанный) сортирует UUID лексикографически, чтобы
		// одна физическая связь порождала один элемент DTO независимо
		// от того, с какой стороны она была прочитана.
		// Для направленной связи ключ отличает исходящую и входящую
		// записи одного типа между теми же сущностями - чтобы при
		// запросе от A сохранялись отдельные outgoing/incoming.
		// Тип связи также входит в ключ - чтобы A--ally--B и A--ally--C
		// не схлопывались в одну запись.
		КлючДедупа = КлючДедупликацииСвязи(ИсходныйОбъект, Описание.ТипСвязи, Связанный,
			Описание.Симметричная, Описание.Направление);
		Если ВиденныеКлючи.Получить(КлючДедупа) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ВиденныеКлючи.Вставить(КлючДедупа, Истина);

		КодТипаСвязи = КешКодовТипов.Получить(Описание.ТипСвязи);
		Если КодТипаСвязи = Неопределено Тогда
			КодТипаСвязи = СвязиСущностей.СтабильныйКодТипаСвязи(Описание.ТипСвязи);
			КешКодовТипов.Вставить(Описание.ТипСвязи, КодТипаСвязи);
		КонецЕсли;

		ИмяТипаСвязи = ?(Описание.ПредставлениеСвязи = Неопределено,
			"", Строка(Описание.ПредставлениеСвязи));

		Строка = Таблица.Добавить();
		Строка.НаправлениеDTO     = НаправлениеDTO;
		Строка.ПорядокНаправления = ПорядокНаправления(НаправлениеDTO);
		Строка.КодТипаСвязи       = КодТипаСвязи;
		Строка.ИмяТипаСвязи       = ИмяТипаСвязи;
		Строка.СвязанныйОбъект    = Связанный;
		Строка.StableCode         = ДанныеСвязанного.StableCode;
		Строка.ИмяСвязанногоОбъекта = ДанныеСвязанного.Имя;
		Строка.Идентификатор      = ДанныеСвязанного.Идентификатор;
		Строка.СортируемоеИмя     = ДанныеСвязанного.СортируемоеИмя;
		Строка.Комментарий        = ?(Описание.Комментарий = Неопределено, "", Описание.Комментарий);

	КонецЦикла;

	Возврат Таблица;

КонецФункции

// Возвращает семантическое направление связи относительно исходного
// объекта: "outgoing" / "incoming" / "symmetric".
//
// Для симметричных связей физическая сторона хранения не влияет:
// результат всегда "symmetric".
//
Функция ОпределитьНаправлениеDTO(Описание)

	Если Описание.Симметричная = Истина Тогда
		Возврат "symmetric";
	КонецЕсли;

	Если Описание.Направление = "Исходящая" Тогда
		Возврат "outgoing";
	ИначеЕсли Описание.Направление = "Входящая" Тогда
		Возврат "incoming";
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает числовой порядок направления для детерминированной
// сортировки: outgoing=1, incoming=2, symmetric=3.
//
Функция ПорядокНаправления(НаправлениеDTO)

	Если НаправлениеDTO = "outgoing" Тогда
		Возврат 1;
	ИначеЕсли НаправлениеDTO = "incoming" Тогда
		Возврат 2;
	Иначе
		Возврат 3;
	КонецЕсли;

КонецФункции

// Формирует ключ дедупликации для физической записи связи.
//
// Для симметричной связи ключ состоит из:
//   - UUID типа связи;
//   - канонической пары UUID сущностей (исходный, связанный) -
//     UUID сортируются лексикографически, чтобы одна и та же
//     физическая связь, прочитанная с обеих сторон, порождала
//     один элемент DTO.
//
// Для направленной связи ключ состоит из:
//   - направления ("Исходящая" / "Входящая");
//   - UUID типа связи;
//   - UUID связанной сущности.
//
// В обоих случаях UUID типа связи обязательно входит в ключ -
// чтобы связи A--ally--B и A--ally--C не схлопывались в одну запись.
//
// Параметры:
//   ИсходныйОбъект - ОпределяемыйТип.СущностиКампании.
//   ТипСвязи       - ОпределяемыйТип.ТипыСвязейСущностей.
//   Связанный      - ОпределяемыйТип.СущностиКампании.
//   Симметричная   - Булево - признак симметричной связи.
//   Направление    - Строка - "Исходящая" / "Входящая" / пусто.
//
// Возвращаемое значение:
//   Строка - стабильный ключ дедупликации.
//
Функция КлючДедупликацииСвязи(ИсходныйОбъект, ТипСвязи, Связанный, Симметричная, Направление)

	КодТипа = НРег(Строка(ТипСвязи.УникальныйИдентификатор()));
	УИДИсходного = НРег(Строка(ИсходныйОбъект.УникальныйИдентификатор()));
	УИДСвязанного = НРег(Строка(Связанный.УникальныйИдентификатор()));

	Если Симметричная Тогда
		// Каноническая пара: меньший UUID идёт первым.
		Если УИДИсходного <= УИДСвязанного Тогда
			Пара = УИДИсходного + "|" + УИДСвязанного;
		Иначе
			Пара = УИДСвязанного + "|" + УИДИсходного;
		КонецЕсли;
		Возврат "symm:" + КодТипа + ":" + Пара;
	КонецЕсли;

	Возврат "dir:" + Направление + ":" + КодТипа + ":" + УИДСвязанного;

КонецФункции

// Возвращает массив ключей соответствия. Используется для передачи
// списка уникальных связанных ссылок в пакетное разрешение.
//
Функция МассивИзКлючейСоответствия(Соответствие)

	Результат = Новый Массив;
	Для Каждого КлючИЗначение Из Соответствие Цикл
		Результат.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пакетно получает имя, стабильный код типа и идентификатор связанных
// сущностей в пределах активной кампании. Записи, ссылающиеся на
// чужие кампании или на удалённые объекты, в результат не попадают.
//
// Реализация собирает один запрос с ОБЪЕДИНИТЬ ВСЕ по тем справочникам
// определяемого типа "СущностиКампании", к которым реально относятся
// переданные ссылки. Фильтрация по нужным ссылкам выполняется на уровне
// СУБД через параметры запроса (В (&СсылкиИмяСправочника)) - чтобы не
// загружать в BSL всю выборку по активной кампании.
//
// Имена таблиц справочников берутся только из внутреннего соответствия
// ПоискСущностей.СоответствиеТиповИСправочников() - никакой пользовательский
// или AI-ввод в текст запроса не попадает.
//
// Параметры:
//   Ссылки    - Массив из ОпределяемыйТип.СущностиКампании.
//   Кампания  - СправочникСсылка.Кампании.
//
// Возвращаемое значение:
//   Соответствие - ключ: ОпределяемыйТип.СущностиКампании,
//                  значение: Структура {Имя, StableCode, Идентификатор,
//                  СортируемоеИмя}.
//
Функция ПакетныеДанныеСвязанныхСущностей(Ссылки, Кампания)

	Результат = Новый Соответствие;

	Если Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Группируем ссылки по типу значения, чтобы:
	//   1) собрать только реально присутствующие stable types;
	//   2) для каждого типа использовать собственный параметр запроса,
	//      что позволяет СУБД применить индекс по ссылке.
	ПоТипам = Новый Соответствие;
	Для Каждого Ссылка Из Ссылки Цикл
		ИмяСправочника = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка)).Имя;
		Массив = ПоТипам.Получить(ИмяСправочника);
		Если Массив = Неопределено Тогда
			Массив = Новый Массив;
			ПоТипам.Вставить(ИмяСправочника, Массив);
		КонецЕсли;
		Если Массив.Найти(Ссылка) = Неопределено Тогда
			Массив.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Кампания", Кампания);

	ТекстыЗапросов = Новый Массив;
	СчПараметра = 0;
	Для Каждого КлючИЗначение Из ПоТипам Цикл

		ИмяСправочника = КлючИЗначение.Ключ;
		МассивСсылок = КлючИЗначение.Значение;

		// Имя параметра должно быть детерминированным и уникальным
		// в пределах запроса, чтобы избежать коллизий при наличии
		// нескольких типов.
		СчПараметра = СчПараметра + 1;
		ИмяПараметра = "СсылкиТипа" + XMLСтрока(СчПараметра);
		Запрос.УстановитьПараметр(ИмяПараметра, МассивСсылок);

		// Фильтр по Спр.Ссылка В (&СсылкиТипаN) применяется на уровне
		// СУБД - в выборку попадают только реально нужные связанные
		// ссылки, а не все элементы справочника активной кампании.
		ТекстыЗапросов.Добавить(
			"ВЫБРАТЬ
			|	Спр.Ссылка КАК Ссылка,
			|	Спр.Наименование КАК Наименование,
			|	""" + ИмяСправочника + """ КАК ИмяСправочника
			|ИЗ
			|	Справочник." + ИмяСправочника + " КАК Спр
			|ГДЕ
			|	Спр.Владелец = &Кампания
			|	И НЕ Спр.ПометкаУдаления
			|	И Спр.Ссылка В (&" + ИмяПараметра + ")");
	КонецЦикла;

	Запрос.Текст = СтрСоединить(ТекстыЗапросов,
		Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Имя = СокрЛП(Строка(Выборка.Наименование));
		ИмяСправочника = Выборка.ИмяСправочника;
		StableCode = ПоискСущностей.StableCodeПоИмениСправочника(ИмяСправочника);
		Данные = Новый Структура;
		Данные.Вставить("Имя",           Имя);
		Данные.Вставить("StableCode",     ?(StableCode = Неопределено, "", StableCode));
		Данные.Вставить("Идентификатор",  НРег(Строка(Выборка.Ссылка.УникальныйИдентификатор())));
		Данные.Вставить("СортируемоеИмя", ПоискСущностей.НормализоватьСтроку(Имя));
		Результат.Вставить(Выборка.Ссылка, Данные);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Преобразует отсортированную таблицу элементов связей и контекст
// исходной сущности в AI-facing DTO. Применяет глобальный limit
// (после сортировки) и вычисляет признак truncated.
//
// Параметры:
//   ИсходныйОбъект      - ОпределяемыйТип.СущностиКампании.
//   StableCode          - Строка - стабильный код типа исходной сущности.
//   ИмяИсходногоОбъекта - Строка.
//   ОписанияЭлементов   - ТаблицаЗначений - результат ЭлементыСвязейДляDTO().
//   Limit               - Число - 1..50.
//
// Возвращаемое значение:
//   Структура - DTO: {entity, items, truncated}.
//
Функция СвязиВDTO(ИсходныйОбъект, StableCode, ИмяИсходногоОбъекта, ОписанияЭлементов, Limit)

	ОбщееЧисло = ОписанияЭлементов.Количество();
	ВозвращаемоеЧисло = Мин(ОбщееЧисло, Limit);
	Truncated = ОбщееЧисло > ВозвращаемоеЧисло;

	DTOЭлементы = Новый Массив;
	Для Сч = 0 По ВозвращаемоеЧисло - 1 Цикл
		Строка = ОписанияЭлементов.Получить(Сч);
		DTOЭлементы.Добавить(ЭлементСвязиВDTO(Строка));
	КонецЦикла;

	DTOEntity = Новый Структура;
	DTOEntity.Вставить("id",   НРег(Строка(ИсходныйОбъект.УникальныйИдентификатор())));
	DTOEntity.Вставить("type", StableCode);
	DTOEntity.Вставить("name", ИмяИсходногоОбъекта);

	DTO = Новый Структура;
	DTO.Вставить("entity",    DTOEntity);
	DTO.Вставить("items",     DTOЭлементы);
	DTO.Вставить("truncated", Truncated);

	Возврат DTO;

КонецФункции

// Преобразует строку таблицы элементов связей в DTO элемента.
// Человекочитаемое имя связи уже учитывает направление
// (вычислено в предметном слое СвязиСущностей.ПолучитьСвязи).
//
Функция ЭлементСвязиВDTO(Строка)

	DTORelation = Новый Структура;
	DTORelation.Вставить("code", Строка.КодТипаСвязи);
	DTORelation.Вставить("name", Строка.ИмяТипаСвязи);

	DTOEntity = Новый Структура;
	DTOEntity.Вставить("id",   Строка.Идентификатор);
	DTOEntity.Вставить("type", Строка.StableCode);
	DTOEntity.Вставить("name", Строка.ИмяСвязанногоОбъекта);

	DTO = Новый Структура;
	DTO.Вставить("direction", Строка.НаправлениеDTO);
	DTO.Вставить("relation",  DTORelation);
	DTO.Вставить("entity",    DTOEntity);
	DTO.Вставить("comment",   Строка.Комментарий);

	Возврат DTO;

КонецФункции

// Преобразует ссылку на сущность в AI-facing DTO.
// Делегирует построение блока details предметной функции для
// соответствующего StableCode. Никогда не возвращает наружу
// ссылок 1С - все идентификаторы передаются в виде UUID,
// перечисления преобразуются в стабильные строковые коды.
//
// Параметры:
//   Объект        - ОпределяемыйТип.СущностиКампании.
//   StableCode    - Строка - стабильный код типа.
//   Наименование  - Строка - каноническое имя сущности.
//
// Возвращаемое значение:
//   Структура - DTO: {id, type, name, details}.
//
Функция СущностьВDTO(Объект, StableCode, Наименование)

	DTO = Новый Структура;
	DTO.Вставить("id", ИдентификаторСущности(Объект));
	DTO.Вставить("type", StableCode);
	DTO.Вставить("name", Наименование);
	DTO.Вставить("details", ДеталиСущностиВDTO(Объект, StableCode));

	Возврат DTO;

КонецФункции

// Возвращает UUID сущности в нижнем регистре. Для невалидированных
// ссылок возвращает пустую строку - такие ситуации не должны
// возникать, так как на этом этапе объект уже прошёл campaign
// isolation в ПоискСущностей.ПолучитьСущностьПоИдентификатору.
//
Функция ИдентификаторСущности(Объект)

	Если НЕ ЗначениеЗаполнено(Объект) Тогда
		Возврат "";
	КонецЕсли;

	Возврат НРег(Строка(Объект.УникальныйИдентификатор()));

КонецФункции

// Диспетчер построения блока details по StableCode. Сами
// типоспецифичные наборы полей описаны в отдельных
// вспомогательных функциях. Любые ссылки 1С внутри details
// преобразуются в компактные reference-DTO либо в null.
//
Функция ДеталиСущностиВDTO(Объект, StableCode)

	Если StableCode = "npc" Тогда
		Возврат ДеталиNPC(Объект);
	ИначеЕсли StableCode = "player_character" Тогда
		Возврат ДеталиПерсонажа(Объект);
	ИначеЕсли StableCode = "location" Тогда
		Возврат ДеталиЛокации(Объект);
	ИначеЕсли StableCode = "quest" Тогда
		Возврат ДеталиКвеста(Объект);
	ИначеЕсли StableCode = "item" Тогда
		Возврат ДеталиПредмета(Объект);
	ИначеЕсли StableCode = "organization" Тогда
		Возврат ДеталиОрганизации(Объект);
	ИначеЕсли StableCode = "event" Тогда
		Возврат ДеталиСобытия(Объект);
	ИначеЕсли StableCode = "note" Тогда
		Возврат ДеталиЗаметки(Объект);
	Иначе
		Возврат Новый Структура;
	КонецЕсли;

КонецФункции

// Детали карточки NPC: раса, профессия, описание. Прямых ссылок
// на другие сущности кампании в метаданных NPC нет.
//
Функция ДеталиNPC(Объект)

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Объект, "Раса, Профессия, Описание");

	Детали = Новый Структура;
	Детали.Вставить("race",      СтрокаРеквизита(Реквизиты, "Раса"));
	Детали.Вставить("profession", СтрокаРеквизита(Реквизиты, "Профессия"));
	Детали.Вставить("description", СтрокаРеквизита(Реквизиты, "Описание"));

	Возврат Детали;

КонецФункции

