//
Функция ДеталиЗаметки(Объект)

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Объект, "Текст, ДатаСоздания");

	Детали = Новый Структура;
	Детали.Вставить("text", СтрокаРеквизита(Реквизиты, "Текст"));
