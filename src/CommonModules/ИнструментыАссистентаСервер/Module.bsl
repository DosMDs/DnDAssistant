// Серверный слой read-only инструментов AI-ассистента.
//
// Назначение:
//   - предоставить единый внутренний boundary для AI-инструментов;
//   - описать реестр доступных инструментов для последующей JSON-сериализации;
//   - выполнить валидацию входных аргументов;
//   - выполнить диспетчеризацию вызовов по белому списку имен;
//   - преобразовать прикладные данные в компактный AI-facing DTO.
//
// Слой не реализует:
//   - HTTP-сервисы;
//   - работу с LLM (Ollama, OpenAI и т. п.);
//   - tool-call loop / orchestrator;
//   - историю сообщений;
//   - write-инструменты;
//   - изменение прикладных данных.
//
// Источник истины по предметным данным:
//   - активная кампания   - УправлениеКампаниями.ПолучитьАктивнуюКампанию();
//   - снимок контекста     - КонтекстАссистента.ПолучитьКонтекст();
//   - имя элемента         - ОбщегоНазначения.ЗначенияРеквизитовОбъекта();
//   - игровая дата         - ИгровойКалендарь.ПредставлениеДаты();
//   - предметный поиск     - ПоискСущностей.
//
// Прямых обращений к регистрам и справочникам модуль не выполняет.
// Привилегированный режим не используется.

#Область ПрограммныйИнтерфейс

// Возвращает реестр доступных AI-инструментов в виде, пригодном
// для последующей JSON-сериализации. Описание не хранится в БД -
// формируется функционально при каждом вызове.
//
// Возвращаемое значение:
//   Массив Из Структура - каждый элемент описывает один инструмент
//     и содержит поля:
//       * name         - Строка - техническое имя инструмента;
//       * description  - Строка - краткое описание для LLM (на русском);
//       * read_only    - Булево - всегда Истина для текущего этапа;
//       * input_schema - Структура - эквивалент JSON Schema,
//       описывающий допустимые аргументы.
//
Функция ПолучитьОписанияИнструментов() Экспорт

	Реестр = Новый Массив;
	Реестр.Добавить(ОписаниеИнструмента_GetCurrentContext());
	Реестр.Добавить(ОписаниеИнструмента_SearchEntities());
	Реестр.Добавить(ОписаниеИнструмента_GetEntity());
	Реестр.Добавить(ОписаниеИнструмента_GetRelations());
	Реестр.Добавить(ОписаниеИнструмента_GetCalendarAgenda());

	Возврат Реестр;

КонецФункции

// Выполняет AI-инструмент по имени и возвращает унифицированный
// результат. Имя инструмента должно присутствовать в белом списке,
// аргументы - соответствовать input_schema соответствующего инструмента.
//
// Параметры:
//   ИмяИнструмента - Строка - техническое имя инструмента
//                  (см. ПолучитьОписанияИнструментов).
//   Аргументы      - Структура, Неопределено - аргументы вызова.
//                  Если для инструмента аргументы не требуются,
//                  допускается Неопределено или пустая Структура.
//
// Возвращаемое значение:
//   Структура - унифицированный результат:
//     * success  - Булево - признак успеха;
//     * data     - Структура, Неопределено - DTO результата при успехе;
//     * error    - Структура, Неопределено - описание ошибки при неуспехе:
//                   * code    - Строка - машинный код ошибки;
//                   * message - Строка - текст для пользователя/AI.
//
Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы = Неопределено) Экспорт

	Если НЕ ЭтоДопустимоеИмяИнструмента(ИмяИнструмента) Тогда
		Возврат РезультатОшибка("unknown_tool",	НСтр("ru = 'Неизвестное имя инструмента.'"));
	КонецЕсли;

	Попытка
		РезультатВызова = ВыполнитьИнструментВнутренний(ИмяИнструмента, Аргументы);
	Исключение
		ЗаписатьОшибкуВЖурнал(
			НСтр("ru = 'AI.Инструменты'", ОбщегоНазначения.КодОсновногоЯзыка()),
			ИмяИнструмента,
			ИнформацияОбОшибке());
		Возврат РезультатОшибка("internal_error",
			НСтр("ru = 'Внутренняя ошибка выполнения инструмента.'"));
	КонецПопытки;

	Возврат РезультатВызова;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Делегирует вызов конкретной реализации по имени инструмента.
// Диспетчеризация выполняется явно, без Выполнить() по строковому имени,
// чтобы произвольная строка от AI не превращалась в вызов метода 1С.
//
// Параметры:
//   ИмяИнструмента - Строка - валидное имя инструмента;
//   Аргументы      - Структура, Неопределено - аргументы вызова.
//
// Возвращаемое значение:
//   Структура - унифицированный результат (см. ВыполнитьИнструмент).
//
Функция ВыполнитьИнструментВнутренний(ИмяИнструмента, Аргументы)

	Если ИмяИнструмента = "get_current_context" Тогда
		Возврат Выполнить_GetCurrentContext(Аргументы);
	ИначеЕсли ИмяИнструмента = "search_entities" Тогда
		Возврат Выполнить_SearchEntities(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_entity" Тогда
		Возврат Выполнить_GetEntity(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_relations" Тогда
		Возврат Выполнить_GetRelations(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_calendar_agenda" Тогда
		Возврат Выполнить_GetCalendarAgenda(Аргументы);
	Иначе
		Возврат РезультатОшибка("unknown_tool",
			НСтр("ru = 'Неизвестное имя инструмента.'"));
	КонецЕсли;

КонецФункции

// Проверяет, что имя инструмента присутствует в белом списке.
//
// Параметры:
//   ИмяИнструмента - Строка.
//
// Возвращаемое значение:
//   Булево - Истина, если имя известно модулю.
//
Функция ЭтоДопустимоеИмяИнструмента(ИмяИнструмента)

	Если ТипЗнч(ИмяИнструмента) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ИмяИнструмента = "get_current_context"
		ИЛИ ИмяИнструмента = "search_entities"
		ИЛИ ИмяИнструмента = "get_entity"
		ИЛИ ИмяИнструмента = "get_relations"
		ИЛИ ИмяИнструмента = "get_calendar_agenda";

КонецФункции

// Формирует описание инструмента get_current_context для реестра.
