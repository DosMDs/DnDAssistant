КонецФункции

// Возвращает строковое значение реквизита, либо пустую строку.
// Используется для безопасного извлечения строковых полей из
// результата ОбщегоНазначения.ЗначенияРеквизитовОбъекта().
//
Функция СтрокаРеквизита(Реквизиты, ИмяПоля)

	Если ТипЗнч(Реквизиты) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Если НЕ Реквизиты.Свойство(ИмяПоля) Тогда
		Возврат "";
	КонецЕсли;

	Значение = Реквизиты[ИмяПоля];
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если Значение = NULL Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

// Возвращает числовое значение реквизита, либо Неопределено.
// Используется для безопасного извлечения числовых полей
// (Уровень, Начало, Окончание).
//
Функция ЧислоРеквизита(Реквизиты, ИмяПоля)

	Если ТипЗнч(Реквизиты) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ Реквизиты.Свойство(ИмяПоля) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = Реквизиты[ИмяПоля];
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Преобразует игровую минуту события в DTO {minute, display}.
// Для пустого значения возвращает Неопределено (сериализуется
// в JSON null).
//
Функция ИгроваяМинутаВDTO(ИгроваяМинута)

	Если ИгроваяМинута = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Представление = ИгровойКалендарь.ПредставлениеДаты(ИгроваяМинута);
	Исключение
		Представление = "";
	КонецПопытки;

	DTO = Новый Структура;
	DTO.Вставить("minute", ИгроваяМинута);
	DTO.Вставить("display", Представление);

	Возврат DTO;

КонецФункции

// Преобразует дату создания заметки в DTO. Возвращает пару
// {date, iso} - где date приведено к числу дней от даты,
// а iso - строковое ISO-представление для удобства AI.
// При отсутствии даты возвращает Неопределено.
//
Функция ДатаСозданияЗаметкиВDTO(Реквизиты)

	Если ТипЗнч(Реквизиты) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ Реквизиты.Свойство("ДатаСоздания") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Дата = Реквизиты.ДатаСоздания;
	Если ТипЗнч(Дата) <> Тип("Дата") Тогда
		Возврат Неопределено;
	КонецЕсли;

	DTO = Новый Структура;
	DTO.Вставить("date", Дата);
	DTO.Вставить("iso", XMLСтрока(Дата));

	Возврат DTO;

КонецФункции

// Возвращает стабильный строковый код статуса квеста по значению
// перечисления СтатусыКвестов. Использует явное локальное
// соответствие - представление перечисления не применяется
// как машинный код.
//
// При пустой ссылке - возвращает Неопределено.
//
Функция КодСтатусаКвеста(Реквизиты)

	Если ТипЗнч(Реквизиты) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ Реквизиты.Свойство("Статус") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Статус = Реквизиты.Статус;
	Если ТипЗнч(Статус) <> Тип("ПеречислениеСсылка.СтатусыКвестов") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Статус = Перечисления.СтатусыКвестов.Новый Тогда
		Возврат "new";
	ИначеЕсли Статус = Перечисления.СтатусыКвестов.Активный Тогда
		Возврат "active";
	ИначеЕсли Статус = Перечисления.СтатусыКвестов.Приостановлен Тогда
		Возврат "paused";
	ИначеЕсли Статус = Перечисления.СтатусыКвестов.Завершен Тогда
		Возврат "completed";
	ИначеЕсли Статус = Перечисления.СтатусыКвестов.Провален Тогда
		Возврат "failed";
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Возвращает стабильный строковый код статуса события по значению
// перечисления СтатусыСобытий. Использует явное локальное
// соответствие - представление перечисления не применяется
// как машинный код.
//
// При пустой ссылке - возвращает Неопределено.
//
Функция КодСтатусаСобытия(Реквизиты)

	Если ТипЗнч(Реквизиты) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ Реквизиты.Свойство("Статус") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Статус = Реквизиты.Статус;
	Если ТипЗнч(Статус) <> Тип("ПеречислениеСсылка.СтатусыСобытий") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Статус = Перечисления.СтатусыСобытий.Запланировано Тогда
		Возврат "planned";
	ИначеЕсли Статус = Перечисления.СтатусыСобытий.Завершено Тогда
		Возврат "completed";
	ИначеЕсли Статус = Перечисления.СтатусыСобытий.Отменено Тогда
		Возврат "cancelled";
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Возвращает строковое имя категории предмета. Категория не входит
// в определяемый тип "СущностиКампании", поэтому reference-DTO
// для неё не строится - только короткое имя.
//
Функция ИмяКатегорииПредмета(Реквизиты)

	Если ТипЗнч(Реквизиты) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ Реквизиты.Свойство("Категория") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Категория = Реквизиты.Категория;
	Если НЕ ЗначениеЗаполнено(Категория) Тогда
		Возврат Неопределено;
	КонецЕсли;

	РеквизитыКатегории = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Категория, "Наименование");

	Если ТипЗнч(РеквизитыКатегории) = Тип("Структура")
		И РеквизитыКатегории.Свойство("Наименование") Тогда
		Возврат Строка(РеквизитыКатегории.Наименование);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Преобразует снимок контекста, полученный из КонтекстАссистента,
// в компактный AI-facing DTO. Не возвращает ссылок 1С наружу -
// все идентификаторы передаются в виде стабильного строкового UUID,
// отсутствующие значения - как Неопределено (сериализуется в JSON null).
//
// Параметры:
//   Снимок - Структура - результат КонтекстАссистента.ПолучитьКонтекст().
//
// Возвращаемое значение:
//   Структура - DTO результата инструмента.
//
Функция СнимокКонтекстаВDTO(Снимок)

	DTO = Новый Структура;
	DTO.Вставить("campaign",  ОписаниеСправочникаВDTO(Снимок.Кампания));
	DTO.Вставить("character", ОписаниеСправочникаВDTO(Снимок.Персонаж));
	DTO.Вставить("location",  ОписаниеСправочникаВDTO(Снимок.Локация));
	DTO.Вставить("game_time", ИгровоеВремяВDTO(Снимок.ИгроваяМинута));
	DTO.Вставить("wallet",    КошелекВDTO(Снимок.Кошелек));

	Возврат DTO;

КонецФункции

// Преобразует ссылку на элемент справочника в DTO с UUID и именем.
// Для пустой ссылки возвращает Неопределено (для сериализации в JSON null).
//
// Параметры:
//   Ссылка - СправочникСсылка, Неопределено - ссылка на элемент справочника.
//
// Возвращаемое значение:
//   Структура, Неопределено - {"id": "...", "name": "..."} или Неопределено.
//
Функция ОписаниеСправочникаВDTO(Ссылка)

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Имя = "";
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Наименование");
	Если ТипЗнч(Реквизиты) = Тип("Структура") И Реквизиты.Свойство("Наименование") Тогда
		Имя = Строка(Реквизиты.Наименование);
	КонецЕсли;

	DTO = Новый Структура;
	DTO.Вставить("id", НРег(Строка(Ссылка.УникальныйИдентификатор())));
	DTO.Вставить("name", Имя);

	Возврат DTO;

КонецФункции

// Преобразует игровое время к DTO. Если минута не задана - возвращает
// Неопределено (сериализуется в JSON null), иначе собирает пару
// исходной минуты и человекочитаемого представления.
//
// Параметры:
//   ИгроваяМинута - Число, Неопределено - минута игрового времени.
//
// Возвращаемое значение:
//   Структура, Неопределено - {"minute": N, "display": "..."} или Неопределено.
//
Функция ИгровоеВремяВDTO(ИгроваяМинута)

	Если ИгроваяМинута = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	DTO = Новый Структура;
	DTO.Вставить("minute", ИгроваяМинута);
	DTO.Вставить("display", ИгровойКалендарь.ПредставлениеДаты(ИгроваяМинута));

	Возврат DTO;

КонецФункции

// Преобразует остаток кошелька к DTO. Если кошелек отсутствует
// (нет активного персонажа) - возвращает Неопределено.
// Номиналы всегда передаются пятью отдельными числовыми полями.
//
// Параметры:
//   Кошелек - Структура, Неопределено - кошелек персонажа.
//
// Возвращаемое значение:
//   Структура, Неопределено - {"pp":..., "gp":..., "ep":..., "sp":..., "cp":...}
//   или Неопределено.
//
Функция КошелекВDTO(Кошелек)

	Если Кошелек = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	DTO = Новый Структура;
	DTO.Вставить("pp", МонетыНоминала(Кошелек, "PP"));
	DTO.Вставить("gp", МонетыНоминала(Кошелек, "GP"));
	DTO.Вставить("ep", МонетыНоминала(Кошелек, "EP"));
	DTO.Вставить("sp", МонетыНоминала(Кошелек, "SP"));
	DTO.Вставить("cp", МонетыНоминала(Кошелек, "CP"));

	Возврат DTO;

КонецФункции

// Возвращает значение номинала из структуры кошелька либо 0,
// если соответствующее поле отсутствует. Защищает DTO от
// неконсистентного остатка.
//
// Параметры:
//   Кошелек - Структура - остаток кошелька;
//   ИмяПоля - Строка - имя номинала ("PP", "GP", "EP", "SP", "CP").
//
// Возвращаемое значение:
//   Число - количество монет указанного номинала.
//
Функция МонетыНоминала(Кошелек, ИмяПоля)

	Если ТипЗнч(Кошелек) <> Тип("Структура") Тогда
		Возврат 0;
	КонецЕсли;

	Если НЕ Кошелек.Свойство(ИмяПоля) Тогда
		Возврат 0;
	КонецЕсли;

	Значение = Кошелек[ИмяПоля];
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Реализация инструмента get_calendar_agenda:
//  1) проверяет допустимость аргументов (from_minute/to_minute/limit по схеме);
//  2) проверяет наличие активной кампании;
//  3) определяет эффективную from_minute: при отсутствии аргумента -
//     текущая игровая минута из КонтекстАссистента; если время не
//     установлено - возвращает стабильную ошибку game_time_not_set;
//  4) читает события активной кампании через прямой запрос
//     к Справочник.События с условиями пересечения диапазонов
//     на уровне СУБД и применением Top-N с limit+1;
//  5) сортирует и обрезает на уровне SQL - в BSL остаётся
//     только преобразование строк выборки в AI-facing DTO;
//  6) обеспечивает campaign isolation (фильтр по Владелец=Кампания
//     и НЕ ПометкаУдаления) и исключает помеченные на удаление
//     события.
//
// Инструмент read-only: не изменяет игровое время, не меняет
// статусы событий и не пишет историю AI.
//
// Параметры:
//   Аргументы - Структура, Неопределено - аргументы инструмента.
//
// Возвращаемое значение:
//   Структура - унифицированный результат.
//
Функция Выполнить_GetCalendarAgenda(Аргументы)

	ПараметрыВызова = ПроверитьАргументы_GetCalendarAgenda(Аргументы);
	Если ТипЗнч(ПараметрыВызова) <> Тип("Структура") Тогда
		Возврат РезультатОшибка("invalid_arguments",
			НСтр("ru = 'Некорректные аргументы get_calendar_agenda.'"));
	КонецЕсли;

	Кампания = УправлениеКампаниями.ПолучитьАктивнуюКампанию();
	Если НЕ ЗначениеЗаполнено(Кампания) Тогда
		Возврат РезультатОшибка("no_active_campaign",
			НСтр("ru = 'Не задана активная кампания.'"));
	КонецЕсли;

	// Определяем эффективную левую границу. Если from_minute не передан -
	// используем текущее игровое время активной кампании. При отсутствии
	// игрового времени возвращаем стабильную ошибку: инструмент не
	// может самостоятельно определить точку отсчёта.
	FromMinute = ПараметрыВызова.FromMinute;
	FromMinuteПередан = ПараметрыВызова.FromMinuteПередан;
	Если НЕ FromMinuteПередан Тогда
		ИгроваяМинутаИзКонтекста = ПолучитьТекущуюИгровуюМинутуАктивнойКампании();
		Если ИгроваяМинутаИзКонтекста = Неопределено Тогда
			Возврат РезультатОшибка("game_time_not_set",
				НСтр("ru = 'В активной кампании не установлено игровое время.'"));
		КонецЕсли;
		FromMinute = ИгроваяМинутаИзКонтекста;
	КонецЕсли;

	ToMinute = ПараметрыВызова.ToMinute;
	ЕстьПраваяГраница = ПараметрыВызова.ToMinuteПередан;

	Лимит = ПараметрыВызова.Limit;

	СтрокиВыборки = ВыбратьСобытияДляАгенды(
		Кампания, FromMinute, ЕстьПраваяГраница, ToMinute, Лимит);

	DTO = АгендаВDTO(Кампания, FromMinute, ЕстьПраваяГраница, ToMinute,
		СтрокиВыборки, Лимит);

	Возврат РезультатУспех(DTO);

КонецФункции

// Проверяет аргументы get_calendar_agenda и приводит их к каноническому
// виду. Возвращает структуру полей (FromMinute, FromMinuteПередан,
// ToMinute, ToMinuteПередан, Limit) при успехе или Неопределено при
// ошибке.
//
// Правила:
//   - from_minute: необязательное целое >= 0; если отсутствует -
//     FromMinute = 0, FromMinuteПередан = Ложь;
//   - to_minute:   необязательное целое >= 0; если отсутствует -
//     ToMinute = 0, ToMinuteПередан = Ложь;
//   - если обе границы переданы - to_minute >= from_minute;
//   - limit: необязательное целое 1..50, по умолчанию 20.
//     Не допускается автоматическое приведение "20" -> 20 или 1.5 -> 2.
//   - Любое дополнительное свойство - ошибка.
//
Функция ПроверитьАргументы_GetCalendarAgenda(Аргументы)

	Если ТипЗнч(Аргументы) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ ТолькоДопустимыеКлючиGetCalendarAgenda(Аргументы) Тогда
		Возврат Неопределено;
	КонецЕсли;

	FromMinute = ПроверитьИИзвлечьFromMinute_GetCalendarAgenda(Аргументы);
	Если Аргументы.Свойство("from_minute") И FromMinute = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ToMinute = ПроверитьИИзвлечьToMinute_GetCalendarAgenda(Аргументы);
	Если Аргументы.Свойство("to_minute") И ToMinute = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	FromMinuteПередан = Аргументы.Свойство("from_minute");
	ToMinuteПередан = Аргументы.Свойство("to_minute");

	// Согласованность границ. Применяется только если обе заданы явно.
	Если FromMinuteПередан И ToMinuteПередан И ToMinute < FromMinute Тогда
		Возврат Неопределено;
	КонецЕсли;

	Limit = ПроверитьИИзвлечьLimit_GetCalendarAgenda(Аргументы);
	Если Аргументы.Свойство("limit") И Limit = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("FromMinute", FromMinute);
	Результат.Вставить("FromMinuteПередан", FromMinuteПередан);
	Результат.Вставить("ToMinute", ToMinute);
	Результат.Вставить("ToMinuteПередан", ToMinuteПередан);
	Результат.Вставить("Limit", Limit);

	Возврат Результат;

КонецФункции

// Проверяет, что в аргументах get_calendar_agenda нет посторонних ключей.
//
Функция ТолькоДопустимыеКлючиGetCalendarAgenda(Аргументы)

	ДопустимыеКлючи = Новый Соответствие;
	ДопустимыеКлючи.Вставить("from_minute", Истина);
	ДопустимыеКлючи.Вставить("to_minute",   Истина);
	ДопустимыеКлючи.Вставить("limit",       Истина);

	Для Каждого КлючИЗначение Из Аргументы Цикл
		Если ДопустимыеКлючи.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Извлекает и валидирует from_minute. Возвращает целое Число >= 0,
// либо 0 при отсутствии свойства. Если свойство задано недопустимым
// значением (Неопределено, не Число, дробь, отрицательное) -
// возвращает Неопределено.
//
Функция ПроверитьИИзвлечьFromMinute_GetCalendarAgenda(Аргументы)

	Если НЕ Аргументы.Свойство("from_minute") Тогда
		Возврат 0;
	КонецЕсли;

	Значение = Аргументы.from_minute;
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Запрет автоматических преобразований 1.5 -> 2.
	Если Значение <> Цел(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Значение < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Извлекает и валидирует to_minute. Правила совпадают с from_minute,
// за исключением особого случая: при отсутствии свойства возвращается 0
// (ToMinuteПередан = Ложь), и согласованность с from_minute
// проверяется в ПроверитьАргументы_GetCalendarAgenda.
//
Функция ПроверитьИИзвлечьToMinute_GetCalendarAgenda(Аргументы)

	Если НЕ Аргументы.Свойство("to_minute") Тогда
		Возврат 0;
	КонецЕсли;

	Значение = Аргументы.to_minute;
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Запрет автоматических преобразований 1.5 -> 2.
	Если Значение <> Цел(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Значение < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Извлекает и валидирует limit. Возвращает целое число 1..50
// (по умолчанию ЛимитПоУмолчанию_GetCalendarAgenda()) либо
// Неопределено, если свойство limit задано некорректно.
//
Функция ПроверитьИИзвлечьLimit_GetCalendarAgenda(Аргументы)

	Если НЕ Аргументы.Свойство("limit") Тогда
		Возврат ЛимитПоУмолчанию_GetCalendarAgenda();
	КонецЕсли;

	Значение = Аргументы.limit;
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Запрет автоматических преобразований 1.5 -> 2.
	Если Значение <> Цел(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Значение < 1 ИЛИ Значение > МаксимальныйЛимит_GetCalendarAgenda() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Лимит get_calendar_agenda по умолчанию.
//
Функция ЛимитПоУмолчанию_GetCalendarAgenda()

	Возврат 20;

КонецФункции

// Верхняя граница лимита get_calendar_agenda.
//
Функция МаксимальныйЛимит_GetCalendarAgenda()

	Возврат 50;

КонецФункции

// Возвращает текущую игровую минуту активной кампании из снимка
// КонтекстАссистента. Если контекст сформировать не удалось
// (например, активная кампания не задана) - возвращает Неопределено.
//
// Используется в R05 как единственный источник from_minute по умолчанию,
// чтобы не дублировать обращения к регистру ИгровоеВремяКампаний.
//
Функция ПолучитьТекущуюИгровуюМинутуАктивнойКампании()

	Попытка
		Снимок = КонтекстАссистента.ПолучитьКонтекст();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Снимок) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ Снимок.Свойство("ИгроваяМинута") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИгроваяМинута = Снимок.ИгроваяМинута;
	Если ТипЗнч(ИгроваяМинута) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ИгроваяМинута;

КонецФункции

// Выполняет предметную выборку событий активной кампании для агенды
// на уровне СУБД. Не загружает весь календарь кампании в память.
//
// Возвращает массив строк выборки с колонками:
//   Ссылка, Наименование, Начало, Окончание, Статус, Описание,
//   ЕстьОкончание (Булево, признак того, что Окончание явно задано).
//
// Параметры:
//   Кампания        - СправочникСсылка.Кампании.
//   FromMinute      - Число - эффективная левая граница.
//   ЕстьПраваяГраница - Булево - задана ли to_minute явно.
//   ToMinute        - Число - эффективная правая граница (если задана).
//   Лимит           - Число - 1..50, фактический лимит для SQL - +1
//                     для определения признака truncated.
//
Функция ВыбратьСобытияДляАгенды(Кампания, FromMinute, ЕстьПраваяГраница, ToMinute, Лимит)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Кампания", Кампания);
	Запрос.УстановитьПараметр("FromMinute", FromMinute);
	Запрос.УстановитьПараметр("Предел", Лимит + 1);

	Если ЕстьПраваяГраница Тогда
		// Ограниченный диапазон. Применяется правило пересечения
		// интервалов согласно существующей календарной семантике:
		//   event.start <= range.end И (event.end отсутствует ИЛИ event.end >= range.start).
		// В 1С незаполненное числовое значение = 0, поэтому условие
		// "Окончание = 0" отделяет точечные события от интервальных.
		Запрос.УстановитьПараметр("ToMinute", ToMinute);
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ &Предел
			|	Спр.Ссылка КАК Ссылка,
			|	Спр.Наименование КАК Наименование,
			|	Спр.Начало КАК Начало,
			|	Спр.Окончание КАК Окончание,
			|	Спр.Статус КАК Статус,
			|	Спр.Описание КАК Описание,
			|	ВЫБОР
			|		КОГДА Спр.Окончание = 0
			|			ТОГДА ЛОЖЬ
			|		ИНАЧЕ ИСТИНА
			|	КОНЕЦ КАК ЕстьОкончание
			|ИЗ
			|	Справочник.События КАК Спр
			|ГДЕ
			|	Спр.Владелец = &Кампания
			|	И НЕ Спр.ПометкаУдаления
			|	И Спр.Начало <= &ToMinute
			|	И (Спр.Окончание = 0
			|			ИЛИ Спр.Окончание >= &FromMinute)
			|
			|УПОРЯДОЧИТЬ ПО
			|	Спр.Начало,
			|	Спр.Окончание,
			|	Спр.Наименование,
			|	Спр.Ссылка";
	Иначе
		// Открытая agenda без to_minute. Сортировка согласно R05:
		//   1) продолжающиеся в момент from_minute (Начало < FromMinute
		//      И Окончание <> 0 И Окончание >= FromMinute);
		//   2) будущие (Начало >= FromMinute);
		//   3) точечные (Окончание = 0) попадают только как будущие.
		// Внутри группы: Начало, Окончание, Имя, UUID.
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ &Предел
			|	Спр.Ссылка КАК Ссылка,
			|	Спр.Наименование КАК Наименование,
			|	Спр.Начало КАК Начало,
			|	Спр.Окончание КАК Окончание,
			|	Спр.Статус КАК Статус,
			|	Спр.Описание КАК Описание,
			|	ВЫБОР
			|		КОГДА Спр.Окончание = 0
			|			ТОГДА ЛОЖЬ
			|		ИНАЧЕ ИСТИНА
			|	КОНЕЦ КАК ЕстьОкончание,
			|	ВЫБОР
			|		КОГДА Спр.Начало < &FromMinute
			|				И Спр.Окончание <> 0
			|				И Спр.Окончание >= &FromMinute
			|			ТОГДА 1
			|		ИНАЧЕ 2
			|	КОНЕЦ КАК РангГруппы
			|ИЗ
			|	Справочник.События КАК Спр
			|ГДЕ
			|	Спр.Владелец = &Кампания
			|	И НЕ Спр.ПометкаУдаления
			|	И (Спр.Начало >= &FromMinute
			|			ИЛИ (Спр.Начало < &FromMinute
			|				И Спр.Окончание <> 0
			|				И Спр.Окончание >= &FromMinute))
			|
			|УПОРЯДОЧИТЬ ПО
			|	РангГруппы,
			|	Спр.Начало,
			|	Спр.Окончание,
			|	Спр.Наименование,
			|	Спр.Ссылка";
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();

	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Описание = Новый Структура;
		Описание.Вставить("Ссылка",         Выборка.Ссылка);
		Описание.Вставить("Наименование",   Выборка.Наименование);
		Описание.Вставить("Начало",         Выборка.Начало);
		Описание.Вставить("Окончание",      Выборка.Окончание);
		Описание.Вставить("ЕстьОкончание",  Выборка.ЕстьОкончание);
		Описание.Вставить("Статус",         Выборка.Статус);
		Описание.Вставить("Описание",       Выборка.Описание);
		Результат.Добавить(Описание);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Преобразует результат выборки и согласованные границы в AI-facing DTO.
// Применяет limit после корректного глобального ранжирования (SQL уже
// отсортировал результат), вычисляет truncated.
//
// Параметры:
//   Кампания        - СправочникСсылка.Кампании.
//   FromMinute      - Число - эффективная левая граница.
//   ЕстьПраваяГраница - Булево.
//   ToMinute        - Число - эффективная правая граница (если задана).
//   СтрокиВыборки   - Массив - результат ВыбратьСобытияДляАгенды().
//   Лимит           - Число - 1..50.
//
// Возвращаемое значение:
//   Структура - DTO: {from, to, items, truncated}.
//
Функция АгендаВDTO(Кампания, FromMinute, ЕстьПраваяГраница, ToMinute, СтрокиВыборки, Лимит)

	ОбщееЧисло = СтрокиВыборки.Количество();
	ВозвращаемоеЧисло = Мин(ОбщееЧисло, Лимит);
	Truncated = ОбщееЧисло > ВозвращаемоеЧисло;

	Items = Новый Массив;
	Для Сч = 0 По ВозвращаемоеЧисло - 1 Цикл
		Items.Добавить(СобытиеАгендыВDTO(СтрокиВыборки[Сч]));
	КонецЦикла;

	DTO = Новый Структура;
	DTO.Вставить("from",      ИгроваяМинутаВDTO(FromMinute));
	DTO.Вставить("to",        ?(ЕстьПраваяГраница, ИгроваяМинутаВDTO(ToMinute), Неопределено));
	DTO.Вставить("items",     Items);
	DTO.Вставить("truncated", Truncated);

	Возврат DTO;

КонецФункции

// Преобразует строку выборки событий в DTO одного элемента агенды.
//
// entity.id - UUID события в нижнем регистре (НРег(Строка(...))).
// entity.type всегда "event".
// start/end - {minute, display} через ИгровойКалендарь.ПредставлениеДаты().
// Если Окончание = 0 (не задано в метаданных), end сериализуется в null.
// status - стабильный код через переиспользование КодСтатусаСобытия()
// из текущего модуля, без дублирования mapping.
//
Функция СобытиеАгендыВDTO(ОписаниеСтроки)

	DTOEntity = Новый Структура;
	DTOEntity.Вставить("id",   НРег(Строка(ОписаниеСтроки.Ссылка.УникальныйИдентификатор())));
	DTOEntity.Вставить("type", "event");
	DTOEntity.Вставить("name", Строка(ОписаниеСтроки.Наименование));

	// Переиспользование существующего mapping статусов R03.
	// КодСтатусаСобытия принимает Структуру с полем "Статус", поэтому
	// оборачиваем текущее значение в фиктивную структуру - это позволяет
	// не дублировать соответствие enum->stable code.
	РеквизитыСтатуса = Новый Структура("Статус", ОписаниеСтроки.Статус);
	Статус = КодСтатусаСобытия(РеквизитыСтатуса);

	Если ОписаниеСтроки.ЕстьОкончание Тогда
		DTOEnd = ИгроваяМинутаВDTO(ОписаниеСтроки.Окончание);
	Иначе
		DTOEnd = Неопределено;
	КонецЕсли;

	DTO = Новый Структура;
	DTO.Вставить("entity",      DTOEntity);
	DTO.Вставить("start",       ИгроваяМинутаВDTO(ОписаниеСтроки.Начало));
	DTO.Вставить("end",         DTOEnd);
	DTO.Вставить("status",      Статус);
	DTO.Вставить("description", Строка(ОписаниеСтроки.Описание));

	Возврат DTO;

КонецФункции

// Формирует структуру успешного результата.
//
// Параметры:
//   DTO - Структура - данные результата.
//
// Возвращаемое значение:
//   Структура - {success: Истина, data: <DTO>, error: Неопределено}.
//
Функция РезультатУспех(DTO)

	Результат = Новый Структура;
	Результат.Вставить("success", Истина);
	Результат.Вставить("data", DTO);
	Результат.Вставить("error", Неопределено);

	Возврат Результат;

КонецФункции

// Формирует структуру ошибочного результата. Текст ошибки
// формируется на русском, код ошибки - стабильный английский.
//
// Параметры:
//   Код     - Строка - машинный код ошибки;
//   Сообщение - Строка - человекочитаемое сообщение.
//
// Возвращаемое значение:
//   Структура - {success: Ложь, data: Неопределено, error: <{code, message}>}.
//
Функция РезультатОшибка(Код, Сообщение)

	Ошибка = Новый Структура;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);

	Результат = Новый Структура;
	Результат.Вставить("success", Ложь);
	Результат.Вставить("data", Неопределено);
	Результат.Вставить("error", Ошибка);

	Возврат Результат;

КонецФункции

// Регистрирует неожиданное исключение в журнале регистрации.
// AI не получает деталей исключения 1С со стеком вызовов -
// только стабильный код internal_error.
//
// Параметры:
//   ИмяСобытия     - Строка - имя события журнала регистрации;
//   ИмяИнструмента - Строка - имя инструмента, при вызове которого
//                     произошло исключение;
//   ИнформацияОбОшибке - ИнформацияОбОшибке - объект с описанием исключения.
//
Процедура ЗаписатьОшибкуВЖурнал(ИмяСобытия, ИмяИнструмента, ИнформацияОбОшибке)

	ПодробностиОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	ТекстОшибки = СтрШаблон(
		НСтр("ru = 'Инструмент: %1
			 |%2'"), ИмяИнструмента, ПодробностиОшибки);

	ЗаписьЖурналаРегистрации(
		ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);

КонецПроцедуры

#КонецОбласти
