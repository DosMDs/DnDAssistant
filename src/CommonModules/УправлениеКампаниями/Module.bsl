// Управление активной кампанией текущего пользователя.
//
// Все остальные модули проекта получают текущую кампанию
// через ПолучитьАктивнуюКампанию() или напрямую из ПараметрыСеанса.АктивнаяКампания,
// без повторных запросов к БД.

#Область СлужебныйПрограммныйИнтерфейс

// Инициализирует активную кампанию текущего пользователя.
//
// Если ПараметрыСеанса.АктивнаяКампания уже заполнен - ничего не делает.
// Иначе пытается загрузить последнюю выбранную кампанию пользователя
// из ХранилищеОбщихНастроек; если сохранённая кампания недоступна -
// выбирает единственную активную кампанию автоматически.
// Если активных кампаний несколько - оставляет параметр пустым.
Процедура ИнициализироватьАктивнуюКампанию() Экспорт

	Если ЗначениеЗаполнено(ПараметрыСеанса.АктивнаяКампания) Тогда
		Возврат;
	КонецЕсли;

	СохраненнаяКампания = ХранилищеОбщихНастроек.Загрузить(
		КлючОбъектаНастроек(), КлючНастройки());

	Если СохраненнаяКампания <> Неопределено
		И ТипЗнч(СохраненнаяКампания) = Тип("СправочникСсылка.Кампании")
		И КампанияДоступна(СохраненнаяКампания) Тогда
		ПараметрыСеанса.АктивнаяКампания = СохраненнаяКампания;
		Возврат;
	КонецЕсли;

	ПараметрыСеанса.АктивнаяКампания = ЕдинственнаяАктивнаяКампания();

КонецПроцедуры

// Устанавливает активную кампанию и сохраняет выбор текущего пользователя.
//
// Параметры:
//  Кампания - СправочникСсылка.Кампании - ссылка на кампанию.
//
// Вызывает исключение, если ссылка пуста, имеет неподдерживаемый тип,
// либо кампания не существует, помечена на удаление или не активна.
Процедура УстановитьАктивнуюКампанию(Кампания) Экспорт

	Если НЕ ЗначениеЗаполнено(Кампания) Тогда
		ВызватьИсключение НСтр("ru = 'Не указана кампания.'");
	КонецЕсли;

	Если ТипЗнч(Кампания) <> Тип("СправочникСсылка.Кампании") Тогда
		ВызватьИсключение НСтр("ru = 'Передано значение неверного типа. Ожидается СправочникСсылка.Кампании.'");
	КонецЕсли;

	Если НЕ КампанияДоступна(Кампания) Тогда
		ВызватьИсключение НСтр("ru = 'Кампания не существует, помечена на удаление или не активна.'");
	КонецЕсли;

	ПараметрыСеанса.АктивнаяКампания = Кампания;

	ХранилищеОбщихНастроек.Сохранить(
		КлючОбъектаНастроек(), КлючНастройки(), Кампания);

КонецПроцедуры

// Возвращает активную кампанию текущего пользователя.
//
// Если параметр сеанса пуст - инициализирует его.
// Повторных запросов к БД при последующих вызовах не выполняет.
//
// Возвращаемое значение:
//   СправочникСсылка.Кампании - активная кампания или пустая ссылка.
Функция ПолучитьАктивнуюКампанию() Экспорт

	Если НЕ ЗначениеЗаполнено(ПараметрыСеанса.АктивнаяКампания) Тогда
		ИнициализироватьАктивнуюКампанию();
	КонецЕсли;

	Возврат ПараметрыСеанса.АктивнаяКампания;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ключ объекта хранилища общих настроек. Стабильное имя логического раздела.
// Используется при сохранении и загрузке последней выбранной кампании.
//
// Возвращаемое значение:
//   Строка - "DndAssistant".
Функция КлючОбъектаНастроек()
	Возврат "DndAssistant";
КонецФункции

// Ключ элемента настройки в ХранилищеОбщихНастроек.
//
// Возвращаемое значение:
//   Строка - "АктивнаяКампания".
Функция КлючНастройки()
	Возврат "АктивнаяКампания";
КонецФункции

// Проверяет, что кампания существует, не помечена на удаление и активна.
//
// Параметры:
//  Кампания - СправочникСсылка.Кампании - проверяемая кампания.
//
// Возвращаемое значение:
//   Булево - Истина, если кампания доступна для выбора.
Функция КампанияДоступна(Кампания)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Кампании.ПометкаУдаления КАК ПометкаУдаления,
		|	Кампании.Активна КАК Активна
		|ИЗ
		|	Справочник.Кампании КАК Кампании
		|ГДЕ
		|	Кампании.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Кампания);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат НЕ Выборка.ПометкаУдаления И Выборка.Активна;

КонецФункции

// Возвращает ссылку на единственную активную кампанию.
// Если активных кампаний нет или их несколько - возвращает пустую ссылку.
//
// Возвращаемое значение:
//   СправочникСсылка.Кампании - активная кампания или пустая ссылка.
Функция ЕдинственнаяАктивнаяКампания()

	ПустаяСсылка = Справочники.Кампании.ПустаяСсылка();

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Кампании.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Кампании КАК Кампании
		|ГДЕ
		|	НЕ Кампании.ПометкаУдаления
		|	И Кампании.Активна
		|УПОРЯДОЧИТЬ ПО
		|	Кампании.Ссылка";

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ПустаяСсылка;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Результат = ПустаяСсылка;
	Количество = 0;

	Пока Выборка.Следующий() Цикл
		Количество = Количество + 1;
		Если Количество > 1 Тогда
			Возврат ПустаяСсылка;
		КонецЕсли;
		Результат = Выборка.Ссылка;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
