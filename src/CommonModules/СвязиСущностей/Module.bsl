////////////////////////////////////////////////////////////////////////////////
// Прикладная логика работы со связями игровых сущностей.
// Все операции записи и чтения регистра СвязиСущностей должны
// выполняться через данный модуль, чтобы UI и будущий AI-слой
// не обращались к регистру напрямую.
//

#Область ПрограммныйИнтерфейс

// Добавляет связь между двумя сущностями активной кампании.
// Если связь уже существует - повторно не создается.
// При необходимости обновляет комментарий у существующей записи.
//
// Параметры:
//  Источник      - ОпределяемыйТип.СущностиКампании - объект-источник связи.
//  ТипСвязи      - СправочникСсылка.ТипыСвязей      - тип устанавливаемой связи.
//  Назначение    - ОпределяемыйТип.СущностиКампании - объект-назначение связи.
//  Комментарий   - Строка                           - произвольный комментарий (необязательный).
//
Процедура ДобавитьСвязь(Источник, ТипСвязи, Назначение, Комментарий = "") Экспорт

	ПроверитьВозможностьОперации(Источник, ТипСвязи, Назначение);

	АктивнаяКампания = АктивнаяКампания();
	РеквизитыТипаСвязи = РеквизитыТипаСвязи(ТипСвязи);
	Симметричная = РеквизитыТипаСвязи.Симметричная;

	НайденнаяЗапись = НайтиЗаписьСвязи(АктивнаяКампания, Источник, Назначение, ТипСвязи, Симметричная);

	Если НайденнаяЗапись = Неопределено Тогда
		СоздатьЗаписьСвязи(АктивнаяКампания, Источник, Назначение, ТипСвязи, Комментарий);
	КонецЕсли;

	Если НайденнаяЗапись <> Неопределено
		И НайденнаяЗапись.Комментарий <> Комментарий Тогда
		ОбновитьКомментарийЗаписи(НайденнаяЗапись, Комментарий);
	КонецЕсли;

КонецПроцедуры

// Удаляет связь между двумя сущностями активной кампании.
// Для симметричной связи поиск ведется без учета направления.
// Если связь не найдена - исключение не возникает.
//
// Параметры:
//  Источник    - ОпределяемыйТип.СущностиКампании - объект-источник связи.
//  ТипСвязи    - СправочникСсылка.ТипыСвязей      - тип удаляемой связи.
//  Назначение  - ОпределяемыйТип.СущностиКампании - объект-назначение связи.
//
Процедура УдалитьСвязь(Источник, ТипСвязи, Назначение) Экспорт

	ПроверитьЗаполнениеПараметров(Источник, ТипСвязи, Назначение);

	АктивнаяКампания = АктивнаяКампания();
	Симметричная = РеквизитыТипаСвязи(ТипСвязи).Симметричная;

	НайденнаяЗапись = НайтиЗаписьСвязи(АктивнаяКампания, Источник, Назначение, ТипСвязи, Симметричная);

	Если НайденнаяЗапись <> Неопределено Тогда
		НаборЗаписей = РегистрыСведений.СвязиСущностей.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Кампания.Установить(НайденнаяЗапись.Кампания);
		НаборЗаписей.Отбор.Источник.Установить(НайденнаяЗапись.Источник);
		НаборЗаписей.Отбор.Назначение.Установить(НайденнаяЗапись.Назначение);
		НаборЗаписей.Отбор.ТипСвязи.Установить(НайденнаяЗапись.ТипСвязи);
		НаборЗаписей.Записать();
	КонецЕсли;

КонецПроцедуры

// Возвращает все связи объекта (исходящие и входящие) активной кампании
// единым списком в унифицированном представлении.
//
// Параметры:
//  Объект - ОпределяемыйТип.СущностиКампании - анализируемая сущность.
//
// Возвращаемое значение:
//  Массив из Структура:
//    * Объект             - ОпределяемыйТип.СущностиКампании
//    * СвязанныйОбъект    - ОпределяемыйТип.СущностиКампании
//    * ТипСвязи           - СправочникСсылка.ТипыСвязей
//    * ПредставлениеСвязи - Строка
//    * Направление        - Строка
//    * Комментарий        - Строка
//
Функция ПолучитьСвязи(Объект) Экспорт

	Результат = Новый Массив;

	Если НЕ ЗначениеЗаполнено(Объект) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Кампания", АктивнаяКампания());
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СвязиСущностей.Источник КАК Источник,
		|	СвязиСущностей.Назначение КАК Назначение,
		|	СвязиСущностей.ТипСвязи КАК ТипСвязи,
		|	СвязиСущностей.Комментарий КАК Комментарий,
		|	ТипыСвязей.Наименование КАК НаименованиеТипа,
		|	ТипыСвязей.ОбратноеНаименование КАК ОбратноеНаименование,
		|	ТипыСвязей.Симметричная КАК Симметричная
		|ИЗ
		|	РегистрСведений.СвязиСущностей КАК СвязиСущностей
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТипыСвязей КАК ТипыСвязей
		|		ПО СвязиСущностей.ТипСвязи = ТипыСвязей.Ссылка
		|ГДЕ
		|	СвязиСущностей.Кампания = &Кампания
		|	И СвязиСущностей.Источник = &Объект
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СвязиСущностей.Источник,
		|	СвязиСущностей.Назначение,
		|	СвязиСущностей.ТипСвязи,
		|	СвязиСущностей.Комментарий,
		|	ТипыСвязей.Наименование,
		|	ТипыСвязей.ОбратноеНаименование,
		|	ТипыСвязей.Симметричная
		|ИЗ
		|	РегистрСведений.СвязиСущностей КАК СвязиСущностей
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТипыСвязей КАК ТипыСвязей
		|		ПО СвязиСущностей.ТипСвязи = ТипыСвязей.Ссылка
		|ГДЕ
		|	СвязиСущностей.Кампания = &Кампания
		|	И СвязиСущностей.Назначение = &Объект";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(ОписаниеСвязи(Объект, Выборка));
	КонецЦикла;

	Возврат Результат;

КонецФункции

