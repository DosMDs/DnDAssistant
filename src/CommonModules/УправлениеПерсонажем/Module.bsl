// Управление активным персонажем текущего пользователя в контексте активной кампании.
//
// Выбор персонажа хранится в ХранилищеОбщихНастроек в разрезе кампании.
// Ключ объекта:   "DndAssistant".
// Ключ настройки: "АктивныйПерсонаж/" + XMLСтрока(Кампания).

#Область ПрограммныйИнтерфейс

// Инициализирует активного персонажа текущего пользователя для активной кампании.
//
// Если активная кампания не заполнена - параметр сеанса очищается.
// Если параметр сеанса уже заполнен и его Владелец = активная кампания - ничего не делает.
// Иначе пытается загрузить сохранённого персонажа для активной кампании; если он
// существует, не помечен на удаление и принадлежит активной кампании - записывает
// его в параметр сеанса. Если сохранённого нет и в активной кампании ровно один
// не помеченный на удаление персонаж - выбирает его автоматически.
// В остальных случаях оставляет параметр пустым.
//
Процедура ИнициализироватьАктивногоПерсонажа() Экспорт

	Кампания = ПараметрыСеанса.АктивнаяКампания;

	Если НЕ ЗначениеЗаполнено(Кампания) Тогда
		ПараметрыСеанса.АктивныйПерсонаж = Справочники.Персонажи.ПустаяСсылка();
		Возврат;
	КонецЕсли;

	ТекущийПерсонаж = ПараметрыСеанса.АктивныйПерсонаж;
	Если ЗначениеЗаполнено(ТекущийПерсонаж)
		И ПерсонажПринадлежитКампании(ТекущийПерсонаж, Кампания) Тогда
		Возврат;
	КонецЕсли;

	СохраненныйПерсонаж = ХранилищеОбщихНастроек.Загрузить(
		КлючОбъектаНастроек(), КлючНастройки(Кампания));

	Если СохраненныйПерсонаж <> Неопределено
		И ТипЗнч(СохраненныйПерсонаж) = Тип("СправочникСсылка.Персонажи")
		И ПерсонажПринадлежитКампании(СохраненныйПерсонаж, Кампания) Тогда
		ПараметрыСеанса.АктивныйПерсонаж = СохраненныйПерсонаж;
		Возврат;
	КонецЕсли;

	ПараметрыСеанса.АктивныйПерсонаж = ЕдинственныйПерсонажКампании(Кампания);

КонецПроцедуры

// Устанавливает активного персонажа и сохраняет выбор текущего пользователя.
//
// Параметры:
//  Персонаж - СправочникСсылка.Персонажи - ссылка на персонажа.
//
// Вызывает исключение, если активная кампания не заполнена,
// персонаж пуст или имеет неподдерживаемый тип,
// персонаж не существует, помечен на удаление или принадлежит другой кампании.
//
Процедура УстановитьАктивногоПерсонажа(Персонаж) Экспорт

	Кампания = ПараметрыСеанса.АктивнаяКампания;

	Если НЕ ЗначениеЗаполнено(Кампания) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнена активная кампания. Выбор персонажа недоступен.'");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Персонаж) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан персонаж.'");
	КонецЕсли;

	Если ТипЗнч(Персонаж) <> Тип("СправочникСсылка.Персонажи") Тогда
		ВызватьИсключение НСтр("ru = 'Передано значение неверного типа. Ожидается СправочникСсылка.Персонажи.'");
	КонецЕсли;

	Если НЕ ПерсонажПринадлежитКампании(Персонаж, Кампания) Тогда
		ВызватьИсключение НСтр("ru = 'Персонаж не существует, помечен на удаление или принадлежит другой кампании.'");
	КонецЕсли;

	ПараметрыСеанса.АктивныйПерсонаж = Персонаж;

	ХранилищеОбщихНастроек.Сохранить(
		КлючОбъектаНастроек(), КлючНастройки(Кампания), Персонаж);

КонецПроцедуры

// Возвращает активного персонажа текущего пользователя.
//
// Если активная кампания не заполнена - возвращает пустую ссылку.
// Если параметр сеанса пуст - инициализирует его. Повторных запросов к БД
// при последующих корректных вызовах не выполняет.
//
// Возвращаемое значение:
//  СправочникСсылка.Персонажи - активный персонаж или пустая ссылка.
//
Функция ПолучитьАктивногоПерсонажа() Экспорт

	Если НЕ ЗначениеЗаполнено(ПараметрыСеанса.АктивнаяКампания) Тогда
		Возврат Справочники.Персонажи.ПустаяСсылка();
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ПараметрыСеанса.АктивныйПерсонаж) Тогда
		ИнициализироватьАктивногоПерсонажа();
	КонецЕсли;

	Возврат ПараметрыСеанса.АктивныйПерсонаж;

КонецФункции

// Сбрасывает активного персонажа текущего пользователя для активной кампании:
// очищает параметр сеанса и удаляет сохранённую настройку.
// Если активная кампания не заполнена - очищается только параметр сеанса.
//
Процедура СброситьАктивногоПерсонажа() Экспорт

	Кампания = ПараметрыСеанса.АктивнаяКампания;
	ПараметрыСеанса.АктивныйПерсонаж = Справочники.Персонажи.ПустаяСсылка();

	Если НЕ ЗначениеЗаполнено(Кампания) Тогда
		Возврат;
	КонецЕсли;

	ХранилищеОбщихНастроек.Удалить(
		КлючОбъектаНастроек(), КлючНастройки(Кампания), ИмяПользователя());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ключ объекта хранилища общих настроек. Стабильное имя логического раздела.
// Используется при сохранении, загрузке и удалении настроек активного персонажа.
//
// Возвращаемое значение:
//  Строка - "DndAssistant".
//
Функция КлючОбъектаНастроек()
	Возврат "DndAssistant";
КонецФункции

// Ключ элемента настройки в ХранилищеОбщихНастроек для конкретной кампании.
//
// Параметры:
//  Кампания - СправочникСсылка.Кампании
//
// Возвращаемое значение:
//  Строка - "АктивныйПерсонаж/<UUID кампании>".
//
Функция КлючНастройки(Кампания)
	Возврат "АктивныйПерсонаж/" + XMLСтрока(Кампания);
КонецФункции

// Проверяет, что персонаж существует, не помечен на удаление, не является группой
// и принадлежит указанной кампании.
//
// Параметры:
//  Персонаж - СправочникСсылка.Персонажи
//  Кампания - СправочникСсылка.Кампании
//
// Возвращаемое значение:
//  Булево - Истина, если персонаж доступен как активный для этой кампании.
//
Функция ПерсонажПринадлежитКампании(Персонаж, Кампания)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Персонаж);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Персонажи.Владелец КАК Владелец,
		|	Персонажи.ПометкаУдаления КАК ПометкаУдаления,
		|	Персонажи.ЭтоГруппа КАК ЭтоГруппа
		|ИЗ
		|	Справочник.Персонажи КАК Персонажи
		|ГДЕ
		|	Персонажи.Ссылка = &Ссылка";

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	Возврат НЕ Выборка.ПометкаУдаления
		И НЕ Выборка.ЭтоГруппа
		И Выборка.Владелец = Кампания;

КонецФункции

// Возвращает единственного не помеченного на удаление не-группового персонажа
// в указанной кампании. Если таких нет или их несколько - возвращает пустую ссылку.
//
// Параметры:
//  Кампания - СправочникСсылка.Кампании
//
// Возвращаемое значение:
//  СправочникСсылка.Персонажи
//
Функция ЕдинственныйПерсонажКампании(Кампания)

	ПустаяСсылка = Справочники.Персонажи.ПустаяСсылка();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Кампания", Кампания);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Персонажи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Персонажи КАК Персонажи
		|ГДЕ
		|	Персонажи.Владелец = &Кампания
		|	И НЕ Персонажи.ПометкаУдаления
		|	И НЕ Персонажи.ЭтоГруппа
		|УПОРЯДОЧИТЬ ПО
		|	Персонажи.Ссылка";

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ПустаяСсылка;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Результат = ПустаяСсылка;
	Количество = 0;

	Пока Выборка.Следующий() Цикл
		Количество = Количество + 1;
		Если Количество > 1 Тогда
			Возврат ПустаяСсылка;
		КонецЕсли;
		Результат = Выборка.Ссылка;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
