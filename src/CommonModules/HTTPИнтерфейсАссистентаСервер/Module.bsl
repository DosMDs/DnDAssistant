// Транспортный адаптер локального HTTP API read-only инструментов
// D&D Assistant. Слой занимается только маршрутизацией запросов между
// HTTP-сервисом APIАссистента и серверным слоем инструментов
// ИнструментыАссистентаСервер.
//
// Адаптер не знает о:
//   - устройстве игровых справочников;
//   - псевдонимах и связях сущностей;
//   - реквизитах событий;
//   - алгоритмах поиска;
//   - правилах DTO отдельных инструментов.
//
// Адаптер отвечает только за:
//   - проверку Content-Type;
//   - ограничение размера тела;
//   - разбор JSON;
//   - сериализацию ответа;
//   - разделение transport-level и tool-level ошибок;
//   - журналирование transport-исключений.
//
// Все прикладные проверки, валидация аргументов, диспетчеризация
// по белому списку, campaign isolation и стабильные DTO выполняются
// в ИнструментыАссистентаСервер.

#Область ПрограммныйИнтерфейс

// Обрабатывает GET /assistant/v1/health.
//
// Возвращает компактный ответ о доступности транспорта. Не выполняет
// обращений к игровым справочным данным, не проверяет активную кампанию
// и не вызывает инструменты.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий запрос платформы.
//
// Возвращаемое значение:
//   HTTPСервисОтвет - ответ с HTTP 200 и JSON {"status":"ok","api_version":"1"}.
Функция ПроверкаСостояния(Запрос) Экспорт

	Ответ = Новый HTTPСервисОтвет(200);
	УстановитьContentTypeJSON(Ответ);

	DTO = Новый Структура;
	DTO.Вставить("status", "ok");
	DTO.Вставить("api_version", "1");

	Ответ.УстановитьТелоИзСтроки(СериализоватьJSON(DTO),
		КодировкаТекста.UTF8, ИспользованиеByteOrderMark.Авто);

	Возврат Ответ;

КонецФункции

// Обрабатывает GET /assistant/v1/tools.
//
// Возвращает реестр инструментов, полученный непосредственно
// из ИнструментыАссистентаСервер.ПолучитьОписанияИнструментов().
// В HTTP-адаптере отдельный список инструментов не формируется.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий запрос платформы.
//
// Возвращаемое значение:
//   HTTPСервисОтвет - ответ с HTTP 200 и унифицированным телом.
Функция ПолучитьИнструменты(Запрос) Экспорт

	Попытка
		Описания = ИнструментыАссистентаСервер.ПолучитьОписанияИнструментов();
	Исключение
		Возврат ОтветTransportОшибка(500, "transport_internal_error",
			НСтр("ru = 'Внутренняя ошибка HTTP-интерфейса ассистента.'"),
			ИнформацияОбОшибке());
	КонецПопытки;

	Данные = Новый Структура;
	Данные.Вставить("tools", Описания);

	Ответ = Новый HTTPСервисОтвет(200);
	УстановитьContentTypeJSON(Ответ);
	Ответ.УстановитьТелоИзСтроки(
		СериализоватьJSON(РезультатУспехJSON(Данные)),
		КодировкаТекста.UTF8, ИспользованиеByteOrderMark.Авто);

	Возврат Ответ;

КонецФункции

// Обрабатывает POST /assistant/v1/tools/{name}.
//
// Извлекает имя инструмента из параметра URL, читает и проверяет
// тело запроса, вызывает ИнструментыАссистентаСервер.ВыполнитьИнструмент
// и сериализует его результат без изменения семантики.
//
// Транспортные ошибки (invalid_json, unsupported_media_type,
// request_too_large, transport_internal_error) возвращаются
// соответствующим HTTP-статусом.
//
// Результат успешно выполненного вызова инструмента и tool-level
// ошибки (unknown_tool, invalid_arguments, no_active_campaign,
// entity_not_found, game_time_not_set, internal_error) возвращаются
// с HTTP 200 и телом {success, data, error}, формируемым
// ИнструментыАссистентаСервер.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий запрос платформы.
//
// Возвращаемое значение:
//   HTTPСервисОтвет - ответ в соответствии с контрактом.
Функция ВыполнитьИнструмент(Запрос) Экспорт

	ИмяИнструмента = ПолучитьИмяИнструментаИзURL(Запрос);
	Если НЕ ЗначениеЗаполнено(ИмяИнструмента) Тогда
		Возврат ОтветTransportОшибка(400, "invalid_request",
			НСтр("ru = 'Не указано имя инструмента в URL.'"));
	КонецЕсли;

	ДвоичныеДанныеТела = Запрос.ПолучитьТелоКакДвоичныеДанные();
	Если НЕ РазмерТелаЗапросаДопустим(ДвоичныеДанныеТела.Размер()) Тогда
		Возврат ОтветTransportОшибка(413, "request_too_large",
			НСтр("ru = 'Размер запроса превышает допустимый предел.'"));
	КонецЕсли;

	ТелоПустое = (ДвоичныеДанныеТела.Размер() = 0);

	Если НЕ ПроверитьContentType(Запрос, ТелоПустое) Тогда
		Возврат ОтветTransportОшибка(415, "unsupported_media_type",
			НСтр("ru = 'Ожидается Content-Type: application/json.'"));
	КонецЕсли;

	Аргументы = ПрочитатьАргументы(ДвоичныеДанныеТела, ТелоПустое, ИмяИнструмента);
	Если Аргументы = Неопределено Тогда
		Возврат ОтветTransportОшибка(400, "invalid_json",
			НСтр("ru = 'Некорректное тело JSON-запроса.'"));
	КонецЕсли;

	Попытка
		РезультатИнструмента = ИнструментыАссистентаСервер.ВыполнитьИнструмент(
			ИмяИнструмента, Аргументы);
	Исключение
		Возврат ОтветTransportОшибка(500, "transport_internal_error",
			НСтр("ru = 'Внутренняя ошибка HTTP-интерфейса ассистента.'"),
			ИнформацияОбОшибке());
	КонецПопытки;

	Ответ = Новый HTTPСервисОтвет(200);
	УстановитьContentTypeJSON(Ответ);
	Ответ.УстановитьТелоИзСтроки(СериализоватьJSON(РезультатИнструмента),
		КодировкаТекста.UTF8, ИспользованиеByteOrderMark.Авто);

	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает максимально допустимый размер тела запроса в байтах.
// 64 KiB достаточно для текущих аргументов инструментов и оставляет
// запас для расширения схем без увеличения риска DoS на HTTP-уровне.
//
// Возвращаемое значение:
//   Число - предельный размер в байтах.
Функция МаксимальныйРазмерТелаЗапроса()

	Возврат 64 * 1024;

КонецФункции

// Проверяет, что размер тела запроса не превышает транспортный лимит.
//
// Параметры:
//   РазмерТела - Число - размер тела в байтах.
//
// Возвращаемое значение:
//   Булево - Истина, если тело укладывается в лимит.
Функция РазмерТелаЗапросаДопустим(РазмерТела)

	Возврат РазмерТела <= МаксимальныйРазмерТелаЗапроса();

КонецФункции

// Проверяет Content-Type входящего запроса.
//
// Допустимые варианты:
//   - application/json (с опциональным параметром charset);
//   - пустой/отсутствующий Content-Type при пустом теле.
//
// Любой другой Content-Type при непустом теле считается
// неподдерживаемым.
//
// Параметры:
//   Запрос      - HTTPСервисЗапрос - входящий запрос.
//   ТелоПустое  - Булево - Истина, если тело запроса пусто.
//
// Возвращаемое значение:
//   Булево - Истина, если Content-Type допустим.
Функция ПроверитьContentType(Запрос, ТелоПустое)

	Если ТелоПустое Тогда
		Возврат Истина;
	КонецЕсли;

	ContentType = Запрос.Заголовки.Получить("Content-Type");
	Если ContentType = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НРег(ОсновнойТипContentType(ContentType)) = "application/json";

КонецФункции

// Выделяет основной MIME-тип из заголовка Content-Type, отбрасывая
// параметры (например, "; charset=utf-8").
//
// Параметры:
//   ContentType - Строка - значение HTTP-заголовка.
//
// Возвращаемое значение:
//   Строка - основной MIME-тип в нижнем регистре без обрамляющих пробелов.
Функция ОсновнойТипContentType(ContentType)

	ПозицияТочкиЗапятой = СтрНайти(ContentType, ";");
	Если ПозицияТочкиЗапятой > 0 Тогда
		Возврат СокрЛП(Лев(ContentType, ПозицияТочкиЗапятой - 1));
	КонецЕсли;

	Возврат СокрЛП(ContentType);

КонецФункции

// Извлекает имя инструмента из параметра URL шаблона
// "/v1/tools/{name}". Имя берётся только из URL, не из тела запроса
// и не из query-параметров.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий запрос.
//
// Возвращаемое значение:
//   Строка - имя инструмента или пустая строка, если параметр не задан.
Функция ПолучитьИмяИнструментаИзURL(Запрос)

	ЗначениеПараметра = Запрос.ПараметрыURL.Получить("name");
	Если ЗначениеПараметра = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(ЗначениеПараметра));

КонецФункции

// Разбирает тело POST-запроса и приводит его к виду, пригодному
// для передачи в ИнструментыАссистентаСервер.ВыполнитьИнструмент.
//
// Правила:
//   - пустое тело трактуется как пустая Структура;
//   - верхний уровень JSON должен быть объектом (Структурой);
//   - массивы, строки, числа, литералы true/false/null и Неопределено
//     на верхнем уровне считаются transport-level invalid_json.
//
// Параметры:
//   ДвоичныеДанныеТела - ДвоичныеДанные - тело запроса.
//   ТелоПустое         - Булево - признак пустого тела.
//   ИмяИнструмента     - Строка - имя инструмента (для журналирования).
//
// Возвращаемое значение:
//   Структура - разобранные аргументы;
//   Неопределено - тело не удалось разобрать как JSON-объект.
Функция ПрочитатьАргументы(ДвоичныеДанныеТела, ТелоПустое, ИмяИнструмента)

	Если ТелоПустое Тогда
		Возврат Новый Структура;
	КонецЕсли;

	СтрокаТела = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеТела,
		КодировкаТекста.UTF8);

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаТела);

	Попытка
		Значение = ПрочитатьJSON(ЧтениеJSON, Ложь);
	Исключение
		ЧтениеJSON.Закрыть();
		ЗаписатьTransportОшибку(
			"AI.HTTP.Transport",
			СтрШаблон(НСтр("ru = 'Невалидный JSON для инструмента %1.'"),
				ИмяИнструмента),
			ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Значение) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Устанавливает HTTP-заголовок Content-Type: application/json; charset=utf-8
// в ответе HTTP-сервиса. Метка порядка байтов в теле не используется -
// кодировка явно объявляется через заголовок.
//
// Параметры:
//   Ответ - HTTPСервисОтвет - формируемый ответ.
Процедура УстановитьContentTypeJSON(Ответ)

	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

КонецПроцедуры

// Сериализует произвольное значение 1С в строку JSON через штатные
// механизмы платформы. Используется компактный формат без переносов
// строк и отступов, что соответствует минимальному контракту API.
//
// Параметры:
//   Значение - Произвольный - сериализуемое значение
//              (Структура, Массив, Число, Строка, Булево, Неопределено).
//
// Возвращаемое значение:
//   Строка - JSON-представление значения.
Функция СериализоватьJSON(Значение)

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(
		ПереносСтрокJSON.Нет, "", Истина, ЭкранированиеСимволовJSON.Нет, Ложь, Истина, Ложь, Ложь, Ложь);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);

	ЗаписатьJSON(ЗаписьJSON, Значение);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Оборачивает полезные данные в унифицированный конверт результата,
// используемый GET /tools и POST /tools/{name}.
//
// Параметры:
//   Данные - Структура - полезные данные результата.
//
// Возвращаемое значение:
//   Структура - {success: Истина, data: <Данные>, error: Неопределено}.
Функция РезультатУспехJSON(Данные)

	Результат = Новый Структура;
	Результат.Вставить("success", Истина);
	Результат.Вставить("data", Данные);
	Результат.Вставить("error", Неопределено);
	Возврат Результат;

КонецФункции

// Формирует HTTP-ответ с transport-level ошибкой.
//
// Параметры:
//   КодОтветаHTTP       - Число - HTTP-статус ответа.
//   КодОшибки           - Строка - стабильный машинный код ошибки.
//   Сообщение           - Строка - человекочитаемое сообщение.
//   ИнформацияОбОшибке  - ИнформацияОбОшибке, Неопределено - сведения
//                         об исключении для журнала регистрации.
//                         Если Неопределено, исключение в журнал не
//                         записывается.
//
// Возвращаемое значение:
//   HTTPСервисОтвет - сформированный ответ с JSON-телом ошибки.
Функция ОтветTransportОшибка(КодОтветаHTTP, КодОшибки, Сообщение, ИнформацияОбОшибке = Неопределено)

	Если ИнформацияОбОшибке <> Неопределено Тогда
		ЗаписатьTransportОшибку("AI.HTTP.Transport",
			СтрШаблон(НСтр("ru = 'Transport-ошибка: %1'"), КодОшибки),
			ИнформацияОбОшибке);
	КонецЕсли;

	ТелоОшибки = РезультатОшибкаJSON(КодОшибки, Сообщение);

	Ответ = Новый HTTPСервисОтвет(КодОтветаHTTP);
	УстановитьContentTypeJSON(Ответ);
	Ответ.УстановитьТелоИзСтроки(СериализоватьJSON(ТелоОшибки),
		КодировкаТекста.UTF8, ИспользованиеByteOrderMark.Авто);

	Возврат Ответ;

КонецФункции

// Формирует структуру transport-level ошибки.
//
// Параметры:
//   Код       - Строка - машинный код ошибки.
//   Сообщение - Строка - человекочитаемое сообщение.
//
// Возвращаемое значение:
//   Структура - {success: Ложь, data: Неопределено, error: {code, message}}.
Функция РезультатОшибкаJSON(Код, Сообщение)

	Ошибка = Новый Структура;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);

	Результат = Новый Структура;
	Результат.Вставить("success", Ложь);
	Результат.Вставить("data", Неопределено);
	Результат.Вставить("error", Ошибка);
	Возврат Результат;

КонецФункции

// Регистрирует transport-исключение в журнале регистрации.
// Клиенту детали исключения не возвращаются - только стабильный код
// transport_internal_error.
//
// Параметры:
//   ИмяСобытия          - Строка - имя события журнала регистрации.
//   Комментарий         - Строка - краткое описание контекста.
//   ИнформацияОбОшибке  - ИнформацияОбОшибке - объект с описанием исключения.
Процедура ЗаписатьTransportОшибку(ИмяСобытия, Комментарий, ИнформацияОбОшибке)

	ПодробностиОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);

	ТекстОшибки = СтрШаблон(
		НСтр("ru = '%1
			|%2'"),
		Комментарий, ПодробностиОшибки);

	ЗаписьЖурналаРегистрации(
		ИмяСобытия,
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ТекстОшибки);

КонецПроцедуры

#КонецОбласти
