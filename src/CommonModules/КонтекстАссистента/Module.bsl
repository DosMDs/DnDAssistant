// Серверный модуль формирования снимка контекста AI-ассистента.
//
// Назначение - собрать в одной точке согласованный набор данных, описывающих
// текущее состояние кампании в момент начала обработки пользовательского запроса:
//   - активную кампанию;
//   - активного персонажа;
//   - текущую локацию кампании;
//   - игровое время (в минутах и в календарном представлении);
//   - физический остаток кошелька активного персонажа.
//
// Контекст собирается один раз в начале обработки запроса и далее
// используется AI / resolver / tools как снимок. Если в процессе работы AI
// изменяет данные, прежний снимок считается устаревшим: при следующем
// пользовательском запросе формируется новый.
//
// Все подсистемы кампании опрашиваются через существующие общие модули
// (УправлениеКампаниями, УправлениеПерсонажем, ИгровоеВремя, ИгровойКалендарь,
// ТекущаяЛокация, КошелекПерсонажа), прямых обращений к регистрам и
// справочникам модуль не выполняет.

#Область ПрограммныйИнтерфейс

// Формирует снимок текущего контекста AI-ассистента.
//
// Вызывает исключение, если у текущего пользователя не задана активная
// кампания - без неё дальнейшая работа AI невозможна. Все остальные поля
// результата могут принимать значение Неопределено, если соответствующие
// данные в базе отсутствуют.
//
// Возвращаемое значение:
//   Структура - снимок контекста со следующими полями:
//     * Кампания       - СправочникСсылка.Кампании - активная кампания;
//     * Персонаж       - СправочникСсылка.Персонажи, Неопределено - активный персонаж активной кампании
//                          либо Неопределено, если персонаж не выбран;
//     * Локация        - СправочникСсылка.Локации, Неопределено - текущая локация активной кампании
//                          либо Неопределено, если локация не задана;
//     * ИгроваяМинута  - Число, Неопределено - текущее игровое время в минутах
//                          либо Неопределено, если время не инициализировано;
//     * ИгроваяДата    - Структура, Неопределено - результат ИгровойКалендарь.ПолучитьДату()
//                          либо Неопределено, если ИгроваяМинута не задана;
//     * Кошелек        - Структура, Неопределено - физический остаток кошелька активного персонажа
//                          (см. КошелекПерсонажа.ПолучитьОстаток())
//                          либо Неопределено, если активный персонаж не выбран.
//
Функция ПолучитьКонтекст() Экспорт

	Кампания = УправлениеКампаниями.ПолучитьАктивнуюКампанию();

	Если НЕ ЗначениеЗаполнено(Кампания) Тогда
		ВызватьИсключение НСтр("ru = 'Не задана активная кампания. Формирование контекста AI-ассистента недоступно.'");
	КонецЕсли;

	Персонаж = УправлениеПерсонажем.ПолучитьАктивногоПерсонажа();
	Если НЕ ЗначениеЗаполнено(Персонаж) Тогда
		Персонаж = Неопределено;
	КонецЕсли;

	ИгроваяМинута = ИгровоеВремя.ПолучитьТекущееВремя();

	ИгроваяДата = Неопределено;
	Если ИгроваяМинута <> Неопределено Тогда
		ИгроваяДата = ИгровойКалендарь.ПолучитьДату(ИгроваяМинута);
	КонецЕсли;

	Локация = ТекущаяЛокация.Получить();

	Кошелек = Неопределено;
	Если Персонаж <> Неопределено Тогда
		Кошелек = КошелекПерсонажа.ПолучитьОстаток(Персонаж);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Кампания", Кампания);
	Результат.Вставить("Персонаж", Персонаж);
	Результат.Вставить("Локация", Локация);
	Результат.Вставить("ИгроваяМинута", ИгроваяМинута);
	Результат.Вставить("ИгроваяДата", ИгроваяДата);
	Результат.Вставить("Кошелек", Кошелек);

	Возврат Результат;

КонецФункции

#КонецОбласти
